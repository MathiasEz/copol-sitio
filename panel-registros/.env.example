# Copiar como .env para probar en la computadora (npm run dev). En Vercel, cargar estos valores en
# Project Settings → Environment Variables del proyecto copol-registros. Este archivo NO lleva valores reales.

# ── Dirección y sesiones ────────────────────────────────────────────────────────────────
# Dirección secreta del panel (8+ letras o números). Sin ella, en la computadora es /panel.
# PANEL_RUTA=/cr-xxxxxxxxxx
# Firma de las cookies: 32+ caracteres al azar. En Vercel es obligatoria.
# SESION_SECRETO=
# PANEL_SESION_INACTIVIDAD_MIN=30
# PANEL_SESION_MAX_HORAS=8

# ── Configuración inicial (crea el administrador principal y el PIN; se usa una vez) ────
PANEL_CODIGO_INICIAL=
# PANEL_ADMIN_INICIAL=bpereira

# ── Código por correo (Resend) ─────────────────────────────────────────────────────────
# RESEND_API_KEY=
# PANEL_CORREO_REMITENTE=Panel COPOL <onboarding@resend.dev>
# Solo en la computadora: muestra el código en la consola en lugar de mandarlo.
# CORREO_CONSOLA=1

# ── Almacén (Vercel → Storage → Blob privado). En la computadora se usan archivos en datos/ ──
# BLOB_READ_WRITE_TOKEN=

# ── Asistente (Vercel AI Gateway; en Vercel no lleva clave) ────────────────────────────
# AI_GATEWAY_API_KEY=
# IA_MODELO=google/gemini-2.5-flash
# IA_LIMITE_DIA=150
# IA_APAGADA=1

# ── Excel en la nube (ver README) ──────────────────────────────────────────────────────
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_CUENTA=
# MS_USUARIO=
# MS_TENANT=common
# Enlace de «Compartir» del archivo (con permiso de edición); si está, se usa en lugar de EXCEL_RUTA.
# EXCEL_ENLACE=
# EXCEL_RUTA=COPOL/Registros COPOL.xlsx
# EXCEL_TABLA=Registros
# MS_REDIRECT_URI=

# ── Google Sheets (gratis; ver README) ─────────────────────────────────────────────────
# GOOGLE_CREDENCIALES={"type":"service_account",...}   (el JSON de la clave, en una línea)
# GOOGLE_HOJA=https://docs.google.com/spreadsheets/d/.../edit
