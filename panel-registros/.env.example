# Copiar como .env para probar en la computadora (npm run dev). En Vercel, cargar estos valores en
# Project Settings → Environment Variables del proyecto copol-registros. Este archivo NO lleva valores reales.

# ── Acceso al panel ─────────────────────────────────────────────────────────────────────
# Clave que comparten los empleados (10 caracteres o más). Cambiarla cierra todas las sesiones.
PANEL_CLAVE=
# PANEL_SESION_HORAS=12

# ── Planilla de Excel (Microsoft Graph) ─────────────────────────────────────────────────
# Aplicación registrada en Microsoft Entra ID (ver README).
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Modo cuenta (recomendado): correo de la cuenta de Microsoft dueña del archivo. Requiere Upstash (abajo).
MS_CUENTA=
# MS_TENANT=common
# Modo aplicación (solo Microsoft 365 empresa, en lugar de MS_CUENTA): dueño del OneDrive y ID del inquilino.
# MS_USUARIO=registros@cooperativapolicial.com.uy
# MS_TENANT=00000000-0000-0000-0000-000000000000
# Archivo dentro del OneDrive de esa cuenta (carpetas separadas con /) y nombre de la tabla.
EXCEL_RUTA=COPOL/Registros COPOL.xlsx
# EXCEL_TABLA=Registros
# Solo si la dirección del panel no es la de Vercel (dominio propio): dirección de vuelta registrada en Entra ID.
# MS_REDIRECT_URI=https://registros.ejemplo.com/api/microsoft/vuelta

# ── Upstash for Redis (Vercel → Storage) ────────────────────────────────────────────────
# Se crean solas al conectar la base al proyecto. Guardan la conexión con Microsoft y los contadores.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Asistente de IA (Vercel AI Gateway) ─────────────────────────────────────────────────
# En Vercel no hace falta clave (usa el token OIDC del despliegue). En la computadora, una clave de AI Gateway.
# AI_GATEWAY_API_KEY=
# IA_MODELO=google/gemini-2.5-flash
# IA_LIMITE_DIA=300
# IA_APAGADA=1
