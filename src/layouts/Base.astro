---
import '../styles/global.css';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import Visor from '../components/Visor.astro';
import Icono from '../components/Icono.astro';
import { CONTACTO, REDES, SITIO, whatsapp } from '../data/confirmado/sitio';

interface Props {
  titulo: string;
  descripcion?: string;
  imagen?: string;
  noIndexar?: boolean;
  /** Sin el botón flotante de WhatsApp (p. ej. en el Bazar, que tiene su propio botón flotante). */
  sinWhatsappFlotante?: boolean;
}

const { titulo, descripcion = SITIO.descripcion, imagen = '/og-copol.jpg', noIndexar: noIndexarPagina = false, sinWhatsappFlotante = false } = Astro.props;
// Copias de prueba (vista previa de Vercel o SITIO_DE_PRUEBA=1 al compilar): que los buscadores no las indexen.
const noIndexar = noIndexarPagina || process.env.VERCEL_ENV === 'preview' || process.env.SITIO_DE_PRUEBA === '1';
const tituloCompleto = Astro.url.pathname === '/' ? `${SITIO.nombre} · ${SITIO.nombreCompleto} — ${SITIO.lema}` : `${titulo} · ${SITIO.nombre} Cooperativa Policial`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${SITIO.nombreCompleto} (${SITIO.nombre})`,
  url: Astro.site?.toString(),
  logo: new URL('/apple-touch-icon.png', Astro.site).toString(),
  slogan: SITIO.lema,
  foundingDate: String(SITIO.fundacion),
  email: CONTACTO.email,
  telephone: '+598 0800 1804',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACTO.casaCentral.direccion,
    addressLocality: CONTACTO.casaCentral.ciudad,
    addressCountry: 'UY',
  },
  sameAs: [REDES.facebook, REDES.instagram],
};
---
<!doctype html>
<html lang="es-UY">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  {noIndexar && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#006633" />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_UY" />
  <meta property="og:site_name" content={`${SITIO.nombre} · ${SITIO.nombreCompleto}`} />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagenAbs} />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify(organizacion)} />
  <script is:inline>
    // Las animaciones de aparición solo se activan con JS disponible y sin preferencia de movimiento reducido.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-animar');
  </script>
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <Encabezado />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Pie />
  <Visor />
  {!sinWhatsappFlotante && (
    <a href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola! Quiero hacer una consulta')} class="wa-flotante" rel="noopener" aria-label={`Escribinos por WhatsApp al ${CONTACTO.whatsappGeneral.texto}`} data-wa-flotante>
      <Icono nombre="whatsapp" tamano={26} />
    </a>
  )}
  <script>
    // Imágenes de .media: aparecen nítidas al terminar de cargar (sin JS se ven directamente).
    // Escucha en fase de captura (load/error no burbujean) para cubrir también las de carga diferida.
    const marcar = (e: Event) => {
      const img = e.target as HTMLElement;
      if (img instanceof HTMLImageElement && img.parentElement?.classList.contains('media')) img.classList.add('cargada');
    };
    document.addEventListener('load', marcar, true);
    document.addEventListener('error', marcar, true);
    document.querySelectorAll<HTMLImageElement>('.media > img').forEach((img) => {
      if (img.complete && img.naturalWidth) img.classList.add('cargada');
    });

    // Escalonado: los hijos de .escalonar aparecen uno tras otro.
    document.querySelectorAll<HTMLElement>('.escalonar').forEach((grupo) => {
      [...grupo.children].forEach((hijo, i) => {
        hijo.classList.add('aparecer');
        (hijo as HTMLElement).style.setProperty('--i', String(Math.min(i, 8)));
      });
    });

    const elementos = document.querySelectorAll('.aparecer, .mascara, [data-revelar]');
    if (document.documentElement.classList.contains('js-animar') && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entradas) => entradas.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            io.unobserve(e.target);
          }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      elementos.forEach((el) => io.observe(el));
    } else {
      elementos.forEach((el) => el.classList.add('visible'));
    }

    // Botón flotante de WhatsApp (solo en pantallas chicas, ver .wa-flotante): aparece al bajar y se
    // oculta sobre el pie (que ya tiene los contactos) para no tapar sus enlaces.
    const flotante = document.querySelector<HTMLElement>('[data-wa-flotante]');
    const pie = document.querySelector('.pie');
    if (flotante) {
      let sobrePie = false;
      const pintar = () => flotante.classList.toggle('wa-flotante--visible', scrollY > 480 && !sobrePie);
      addEventListener('scroll', pintar, { passive: true });
      if (pie && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => { sobrePie = e.isIntersecting; pintar(); }).observe(pie);
      pintar();
    }

    // Estadísticas propias (panel/src/estadisticas.ts): sin cookies ni datos personales. Cuenta la vista de
    // la página y los clics a WhatsApp y al banner. No cuenta navegadores automatizados (pruebas).
    const enviar = (datos: Record<string, unknown>) => {
      if (navigator.webdriver) return;
      try {
        const cuerpo = JSON.stringify({ r: location.pathname, ...datos });
        if (!navigator.sendBeacon?.('/api/e', new Blob([cuerpo], { type: 'text/plain' }))) fetch('/api/e', { method: 'POST', body: cuerpo, keepalive: true }).catch(() => {});
      } catch { /* las estadísticas nunca interrumpen la página */ }
    };
    (window as unknown as { copolEstadistica: typeof enviar }).copolEstadistica = enviar;
    enviar({ t: 'vista', ref: document.referrer, m: matchMedia('(max-width: 899px), (pointer: coarse)').matches });
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest?.<HTMLAnchorElement>('a[href]');
      if (!a) return;
      if (a.href.startsWith('https://wa.me/')) enviar({ t: 'whatsapp', u: a.href });
      else if (a.closest('copol-banner')) enviar({ t: 'banner', d: a.closest('[data-bi-diapo]')?.getAttribute('aria-label')?.replace(/^\d+ de \d+: /, '') ?? '' });
    }, { capture: true });
  </script>
</body>
</html>

<style>
  main:focus { outline: none; }

  /* Botón flotante de WhatsApp (plan de mejoras V5): solo en celulares y tablets. */
  .wa-flotante {
    position: fixed; z-index: 30; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom));
    display: none; place-items: center; width: 56px; height: 56px; border-radius: 999px;
    background: var(--verde-copol); color: var(--blanco); text-decoration: none;
    box-shadow: 0 14px 30px -10px rgb(0 51 26 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.18);
    opacity: 0; transform: translateY(16px) scale(0.9); pointer-events: none;
    transition: opacity 260ms var(--ease-out-quart), transform 500ms var(--resorte), background var(--transicion);
  }
  .wa-flotante--visible { opacity: 1; transform: none; pointer-events: auto; }
  .wa-flotante:active { transform: scale(0.94); }
  .wa-flotante:focus-visible { outline: 3px solid var(--amarillo-copol); outline-offset: 3px; }
  @media (max-width: 899px) { .wa-flotante { display: grid; } }
  @media (prefers-reduced-motion: reduce) { .wa-flotante { transition: opacity 120ms linear; transform: none; } }
</style>
