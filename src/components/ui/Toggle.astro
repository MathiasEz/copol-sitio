---
// ToggleGroupItem (anatomía shadcn/ui) sobre un radio nativo: accesible por teclado y sin JS.
// Agrupar varios dentro de <fieldset class="toggle-group"> con un <legend>.
interface Props {
  name: string;
  value: string;
  checked?: boolean;
  contador?: number;
}
const { name, value, checked = false, contador } = Astro.props;
---
<label class="toggle">
  <input type="radio" name={name} value={value} checked={checked} />
  <span><slot /></span>
  {contador !== undefined && <span class="toggle__contador">{contador}</span>}
</label>
