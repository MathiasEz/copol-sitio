---
// Accordion (anatomía shadcn/ui) sobre <details>/<summary>: funciona sin JS y con teclado.
import Icono from '../Icono.astro';

interface Props {
  items: { titulo: string; contenido: string }[];
  class?: string;
}
const { items, class: clase } = Astro.props;
---
<div class:list={['accordion', clase]}>
  {items.map((it) => (
    <details class="accordion__item">
      <summary class="accordion__trigger">{it.titulo}<Icono nombre="chevron-abajo" tamano={20} /></summary>
      <p class="accordion__contenido">{it.contenido}</p>
    </details>
  ))}
</div>
