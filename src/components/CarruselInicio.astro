---
// Carrusel de Inicio.
// - Navegación: flechas discretas a los lados de los indicadores, deslizar (táctil o arrastrando con
//   el mouse), flechas ←/→ del teclado con el carrusel enfocado e indicadores (barras de progreso)
//   que también son botones accesibles.
// - Movimiento: el texto sube desde una máscara y las imágenes forman un mazo en abanico que rota
//   (idea tomada de prompt-motion.com). Sin fundidos genéricos ni desenfoques.
// - Avance automático cada 2,5 s, en bucle. Un gesto del usuario (flecha, indicador, deslizar)
//   reinicia la cuenta; se pausa con el puntero o el foco encima y con la pestaña oculta. Con
//   prefers-reduced-motion no avanza ni anima.
// - Sin JS: las diapositivas se muestran apiladas y todo el contenido queda disponible.
import { Image } from 'astro:assets';
import { foto } from '../lib/imagenes';
import { proximasAperturas } from '../lib/datos';
import { CONTACTO, whatsapp } from '../data/confirmado/sitio';
import Button from './ui/Button.astro';
import Icono from './Icono.astro';

const proxima = proximasAperturas()[0];

const diapositivas = [
  {
    id: 'institucional',
    antetitulo: 'Cooperativa de consumo · Desde 1917',
    titulo: 'Bienes, servicios y soluciones para vos y',
    resaltado: 'tu familia',
    texto: 'Créditos, Tienda, Bazar, turismo y servicios sociales, con atención cercana en 19 locales de todo el país.',
    acciones: [
      { texto: 'Hacete socio', href: '/hacete-socio/', variante: 'default', flecha: true },
      { texto: 'Conocé los beneficios', href: '/beneficios/', variante: 'outline' },
    ],
    imagen: foto('pinecoop-salinas'),
    posicion: '50% 62%',
    etiqueta: 'Parque Vacacional Pinecoop',
  },
  {
    id: 'pinecoop',
    antetitulo: 'Servicios sociales · Turismo',
    titulo: 'Parque Vacacional Pinecoop',
    texto: 'Tu espacio de descanso frente al mar en Salinas: cabañas equipadas, piscina climatizada y bajada directa a la playa.',
    acciones: [
      { texto: 'Conocé Pinecoop', href: '/beneficios/servicios-sociales/pinecoop/', variante: 'default', flecha: true },
      { texto: 'Consultá por WhatsApp', href: whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola, quiero info sobre Pinecoop'), variante: 'outline' },
    ],
    imagen: foto('pinecoop-chuy'),
    posicion: '50% 55%',
    etiqueta: 'Próximamente: Pinecoop Chuy',
  },
  {
    id: 'motos',
    antetitulo: 'Bazar · Nuevos ingresos',
    titulo: 'Llevate tu moto 0 km',
    texto: 'Zanella Pollerita y Sapucai, hasta en 15 cuotas sin recargo. Vení a verlas al local o consultá por WhatsApp.',
    acciones: [
      { texto: 'Ver el Bazar', href: '/hipermercado/bazar/', variante: 'default', flecha: true },
      { texto: 'Consultar', href: whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola! Quiero info sobre las motos nuevas en stock'), variante: 'outline' },
    ],
    imagen: foto('banner-motos-1'),
    posicion: '50% 50%',
  },
  {
    id: 'garantia',
    antetitulo: 'Nuevo convenio',
    titulo: 'Garantía de alquiler con Porto Seguro',
    texto: 'Garantía de alquiler en todo el país, hasta en 10 cuotas sin tarjeta.',
    acciones: [
      { texto: 'Ver convenios', href: '/beneficios/convenios/', variante: 'default', flecha: true },
      { texto: 'Consultar', href: whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola, quiero info sobre la garantía de alquiler'), variante: 'outline' },
    ],
    imagen: foto('banner-garantia-alquiler'),
    posicion: '60% 50%',
  },
] as const;
const total = diapositivas.length;
---
<!-- Título de la página siempre presente: el carrusel oculta las diapositivas que no están activas. -->
<h1 class="visualmente-oculto">COPOL · Cooperativa Policial</h1>
<section class="hero" aria-roledescription="carrusel" aria-label="Novedades destacadas" aria-describedby="hero-instrucciones" data-carrusel>
  <p id="hero-instrucciones" class="visualmente-oculto">Deslizá o usá las flechas izquierda y derecha del teclado para cambiar de novedad.</p>
  <div class="contenedor hero__marco">
    <div class="hero__textos" aria-live="off" data-paneles>
      {diapositivas.map((d, i) => (
        <div
          class:list={['hero__panel', { activa: i === 0 }]}
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${total}`}
          data-panel
        >
          <span class="hero__antetitulo">{d.antetitulo}</span>
          <h2 class="hero__titulo"><span class="hero__linea">{d.titulo} {'resaltado' in d && <span class="hero__resaltado">{d.resaltado}</span>}</span></h2>
          <p class="lead">{d.texto}</p>
          <div class="hero__acciones">
            {d.acciones.map((a) => (
              <Button href={a.href} variant={a.variante as 'default' | 'outline'} size="lg">
                {a.texto}{'flecha' in a && <Icono nombre="flecha" tamano={18} />}
              </Button>
            ))}
          </div>
        </div>
      ))}

      <div class="hero__controles" data-controles hidden>
      <button type="button" class="hero__flecha" data-anterior aria-label="Novedad anterior"><Icono nombre="chevron-izq" tamano={18} /></button>
      <div class="hero__indicadores" role="group" aria-label="Elegir novedad">
        {diapositivas.map((d, i) => (
          <button
            type="button"
            class="hero__indicador"
            data-indicador={i}
            aria-label={`Mostrar novedad ${i + 1}: ${d.titulo}${'resaltado' in d ? ` ${d.resaltado}` : ''}`}
            aria-current={i === 0 ? 'true' : undefined}
          ><span class="hero__progreso"></span></button>
        ))}
      </div>
      <button type="button" class="hero__flecha" data-siguiente aria-label="Novedad siguiente"><Icono nombre="chevron-der" tamano={18} /></button>
      </div>
    </div>

    <div class="hero__mazo" aria-hidden="true" data-mazo>
      {diapositivas.map((d, i) => (
        <div class="hero__carta" data-pos={i} data-carta={i} style={`--pos-img: ${d.posicion}`}>
          <Image src={d.imagen} alt="" widths={[480, 720, 960, 1280]} sizes="(min-width: 1000px) 600px, 92vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
          {'etiqueta' in d && <span class="hero__etiqueta">{d.etiqueta}</span>}
        </div>
      ))}
      {proxima && (
        <a href="/acceso-web/" class="hero__tarjeta" data-tarjeta-credito tabindex="-1">
          <span class="hero__tarjeta-fecha"><strong>{proxima.dia}</strong>{proxima.mesCorto}</span>
          <span><small>Próxima apertura</small> de créditos</span>
        </a>
      )}
    </div>
  </div>
  {proxima && (
    <p class="visualmente-oculto">Próxima apertura de créditos: {proxima.dia} de {proxima.mes}.</p>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-carrusel]').forEach((carrusel) => {
    const paneles = [...carrusel.querySelectorAll<HTMLElement>('[data-panel]')];
    const cartas = [...carrusel.querySelectorAll<HTMLElement>('[data-carta]')];
    const indicadores = [...carrusel.querySelectorAll<HTMLButtonElement>('[data-indicador]')];
    const contenedorTextos = carrusel.querySelector<HTMLElement>('[data-paneles]')!;
    const tarjetaCredito = carrusel.querySelector<HTMLElement>('[data-tarjeta-credito]');
    const n = paneles.length;
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    carrusel.classList.add('hero--js');
    carrusel.tabIndex = 0;
    carrusel.querySelector<HTMLElement>('[data-controles]')!.hidden = false;

    let actual = 0;
    const automatico = !reducido;

    const mostrar = (i: number, porUsuario = false) => {
      actual = (i + n) % n;
      paneles.forEach((p, k) => {
        const activa = k === actual;
        p.classList.toggle('activa', activa);
        p.toggleAttribute('inert', !activa);
        p.setAttribute('aria-hidden', String(!activa));
      });
      cartas.forEach((c, k) => {
        c.dataset.pos = String((k - actual + n) % n);
        // Precarga la carta siguiente para que nunca aparezca en blanco.
        if (c.dataset.pos === '1') c.querySelector('img')?.setAttribute('loading', 'eager');
      });
      indicadores.forEach((b, k) => {
        if (k === actual) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
        // Reinicia la animación de progreso del indicador activo.
        const barra = b.firstElementChild as HTMLElement;
        barra.style.animation = 'none';
        void barra.offsetWidth;
        barra.style.animation = '';
      });
      tarjetaCredito?.classList.toggle('visible', actual === 0);
      contenedorTextos.setAttribute('aria-live', porUsuario ? 'polite' : 'off');
    };

    // El progreso del indicador activo es una animación CSS de 2,5 s: al terminar, avanza (en bucle).
    // Cada cambio reinicia la animación, así que un gesto del usuario también reinicia la cuenta.
    indicadores.forEach((b) => {
      b.firstElementChild!.addEventListener('animationend', () => {
        if (automatico) mostrar(actual + 1);
      });
    });
    if (automatico) carrusel.classList.add('hero--auto');

    indicadores.forEach((b, k) => b.addEventListener('click', () => mostrar(k, true)));
    carrusel.querySelector('[data-anterior]')!.addEventListener('click', () => mostrar(actual - 1, true));
    carrusel.querySelector('[data-siguiente]')!.addEventListener('click', () => mostrar(actual + 1, true));

    carrusel.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('a, input')) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); mostrar(actual - 1, true); }
      if (e.key === 'ArrowRight') { e.preventDefault(); mostrar(actual + 1, true); }
    });

    // Gestos: deslizar en horizontal (táctil o mouse). El scroll vertical sigue funcionando.
    let x0 = 0, y0 = 0, arrastrando = false;
    carrusel.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      arrastrando = true; x0 = e.clientX; y0 = e.clientY;
    });
    carrusel.addEventListener('pointerup', (e) => {
      if (!arrastrando) return;
      arrastrando = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.2) mostrar(actual + (dx < 0 ? 1 : -1), true);
    });
    carrusel.addEventListener('pointercancel', () => (arrastrando = false));

    // Pausa temporal con el puntero o el foco dentro (el progreso se congela).
    const pausar = (si: boolean) => carrusel.classList.toggle('hero--pausado', si);
    carrusel.addEventListener('mouseenter', () => pausar(true));
    carrusel.addEventListener('mouseleave', () => pausar(false));
    carrusel.addEventListener('focusin', () => pausar(true));
    carrusel.addEventListener('focusout', (e) => !carrusel.contains(e.relatedTarget as Node | null) && pausar(false));
    document.addEventListener('visibilitychange', () => pausar(document.hidden));

    mostrar(0);
  });
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    padding-block: clamp(28px, 5vw, 72px) clamp(36px, 5vw, 64px);
    overflow: hidden;
    touch-action: pan-y;
  }
  .hero:focus-visible { outline-offset: -6px; border-radius: 0; }
  .hero__marco {
    display: grid;
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__marco { grid-template-columns: 1fr 1.05fr; }
  }

  /* ── Textos ── */
  .hero__textos { display: grid; gap: 28px; }
  .hero__panel { display: grid; gap: 20px; justify-items: start; align-content: center; }
  .hero__panel + .hero__panel { padding-top: 32px; border-top: 1px solid var(--border); }
  .hero__antetitulo {
    font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--verde-oscuro); background: var(--background); padding: 6px 14px; border-radius: var(--radio-pill);
    box-shadow: var(--anillo);
  }
  .hero__titulo { font-size: clamp(2.25rem, 5vw, 3.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.04; }
  .hero__linea { display: block; }
  .hero__resaltado { background: var(--accent); padding: 0 0.16em; border-radius: 0.2em; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero--js .hero__textos > .hero__panel { grid-area: 1 / 1; padding-top: 0; border: 0; }
  .hero--js .hero__panel:not(.activa) { visibility: hidden; }
  .hero--js .hero__controles { grid-area: 2 / 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero--js .hero__panel { transition: visibility 0s linear 450ms; }
    .hero--js .hero__panel.activa { transition-delay: 0s; }
    .hero--js .hero__panel > * {
      transition: opacity 450ms var(--ease-out-quart), transform 800ms var(--resorte);
    }
    .hero--js .hero__panel:not(.activa) > * { opacity: 0; transform: translateY(14px); }
    .hero--js .hero__panel.activa > :nth-child(2) { transition-delay: 60ms; }
    .hero--js .hero__panel.activa > :nth-child(3) { transition-delay: 120ms; }
    .hero--js .hero__panel.activa > :nth-child(4) { transition-delay: 180ms; }
    /* El título sube desde una línea de máscara */
    .hero--js .hero__titulo { overflow: hidden; padding-bottom: 0.18em; margin-bottom: -0.18em; }
    .hero--js .hero__linea { transition: transform 900ms var(--ease-out-quart); }
    .hero--js .hero__panel:not(.activa) .hero__linea { transform: translateY(105%); }
    .hero--js .hero__panel:not(.activa) .hero__titulo { opacity: 1; transform: none; }
  }

  /* ── Indicadores discretos (barras de progreso) ── */
  .hero__controles { display: flex; align-items: center; gap: 2px; margin-left: -8px; }
  .hero__indicadores { display: flex; gap: 4px; align-items: center; }
  /* Flechas discretas: ícono chico en un círculo tenue; área táctil de 44 px. */
  .hero__flecha {
    display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none;
    color: var(--verde-oscuro); cursor: pointer; border-radius: var(--radio-pill); position: relative;
  }
  .hero__flecha::before {
    content: ''; position: absolute; inset: 7px; border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(0 102 51 / 0.25); transition: background var(--transicion), box-shadow var(--transicion);
  }
  .hero__flecha :global(svg) { position: relative; opacity: 0.75; transition: opacity var(--transicion); }
  .hero__flecha:hover::before { background: var(--muted); box-shadow: inset 0 0 0 1px rgb(0 102 51 / 0.45); }
  .hero__flecha:hover :global(svg) { opacity: 1; }
  .hero__flecha:focus-visible { outline: 3px solid var(--ring); outline-offset: -3px; }
  .hero__indicador {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 8px;
  }
  .hero__progreso {
    position: relative; display: block; width: 28px; height: 4px; border-radius: 4px;
    background: rgb(0 102 51 / 0.18); overflow: hidden;
    transition: width 400ms var(--resorte);
  }
  .hero__progreso::after {
    content: ''; position: absolute; inset: 0; background: var(--verde-oscuro);
    transform-origin: left; transform: scaleX(0);
  }
  .hero__indicador:hover .hero__progreso { background: rgb(0 102 51 / 0.35); }
  .hero__indicador[aria-current='true'] .hero__progreso { width: 44px; }
  .hero__indicador[aria-current='true'] .hero__progreso::after { transform: scaleX(1); }
  .hero--auto .hero__indicador[aria-current='true'] .hero__progreso::after { animation: progreso 2.5s linear forwards; }
  .hero--auto.hero--pausado .hero__progreso::after { animation-play-state: paused; }
  @keyframes progreso { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* ── Mazo de imágenes en abanico ── */
  .hero__mazo {
    position: relative;
    display: grid;
    padding-top: clamp(28px, 4vw, 48px);
    padding-right: clamp(20px, 3vw, 40px);
    user-select: none;
    --spread: 0px;
  }
  .hero__carta {
    grid-area: 1 / 1;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radio-xl);
    overflow: hidden;
    background: var(--background);
    box-shadow: var(--anillo), 0 30px 60px -28px rgb(0 51 26 / 0.45);
    transform-origin: 50% 100%;
    transition: transform 900ms var(--resorte), opacity 500ms var(--ease-out-quart), filter 500ms var(--ease-out-quart);
  }
  .hero__carta :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos-img, 50% 50%); pointer-events: none; }
  .hero__carta[data-pos='0'] { z-index: 4; }
  .hero__carta[data-pos='1'] { z-index: 3; transform: translate(calc(4% + var(--spread)), calc(-7% - var(--spread))) scale(0.93) rotate(2deg); filter: saturate(0.7) brightness(0.96); }
  .hero__carta[data-pos='2'] { z-index: 2; transform: translate(calc(8% + var(--spread) * 2), calc(-14% - var(--spread) * 2)) scale(0.86) rotate(4deg); filter: saturate(0.5) brightness(0.93); opacity: 0.85; }
  .hero__carta[data-pos='3'] { z-index: 5; transform: translate(-16%, 6%) scale(0.95) rotate(-5deg); opacity: 0; pointer-events: none; }
  @media (hover: hover) and (pointer: fine) {
    .hero__mazo:hover { --spread: 12px; }
  }
  .hero__etiqueta {
    position: absolute; left: 16px; top: 16px;
    background: var(--verde-oscuro); color: var(--blanco);
    font-weight: 700; font-size: 0.875rem; padding: 7px 14px; border-radius: var(--radio-pill);
  }
  .hero__carta:not([data-pos='0']) .hero__etiqueta { opacity: 0; }

  .hero__tarjeta {
    position: absolute; z-index: 6; left: clamp(-8px, -1.5vw, 12px); bottom: clamp(-18px, -1.5vw, 12px);
    display: flex; gap: 14px; align-items: center;
    background: var(--background); color: var(--verde-oscuro); text-decoration: none;
    border-radius: var(--radio-lg); padding: 12px 18px 12px 12px; box-shadow: var(--sombra), var(--anillo);
    font-weight: 700; font-size: 1rem; line-height: 1.2;
    opacity: 0; transform: translateY(12px) scale(0.96); pointer-events: none;
    transition: opacity 400ms var(--ease-out-quart), transform 700ms var(--resorte);
  }
  .hero__tarjeta.visible { opacity: 1; transform: none; pointer-events: auto; }
  .hero__tarjeta small { display: block; font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted-foreground); }
  .hero__tarjeta-fecha { display: grid; justify-items: center; background: var(--accent); color: var(--verde-oscuro); border-radius: var(--radio-md); padding: 6px 12px; font-size: 0.8125rem; }
  .hero__tarjeta-fecha strong { font-size: 1.625rem; line-height: 1; }
  /* Sin JS el mazo muestra solo la primera carta y la tarjeta de crédito queda visible */
  .hero:not(.hero--js) .hero__tarjeta { opacity: 1; transform: none; pointer-events: auto; }

  @media (max-width: 599px) {
    /* En móvil la tarjeta taparía la foto; las fechas se muestran en la sección de créditos. */
    .hero__tarjeta { display: none; }
    .hero__acciones :global(.btn) { flex: 1 1 100%; }
  }
  @media (max-width: 999px) {
    .hero__mazo { order: -1; padding-right: 22px; padding-top: 30px; }
    .hero__tarjeta { left: 10px; bottom: 10px; padding: 8px 14px 8px 8px; font-size: 0.9375rem; }
    .hero__tarjeta-fecha strong { font-size: 1.375rem; }
  }
</style>
