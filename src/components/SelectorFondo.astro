---
// Switch para comparar dos fondos claros de página (no es un modo oscuro):
//   Blanco · Blanco verdoso (#eaf4ee, Manual de marca COPOL 2026).
// La elección se guarda en el navegador (localStorage) y se aplica antes de pintar la página
// (script en src/layouts/Base.astro). Sin JS queda el fondo predeterminado.
---
<div class="selector-fondo" role="radiogroup" aria-label="Color de fondo de la página" data-selector-fondo>
  <span class="selector-fondo__titulo" aria-hidden="true">Fondo</span>
  <label class="selector-fondo__op">
    <input type="radio" name="fondo-pagina" value="blanco" />
    <span><i class="selector-fondo__muestra selector-fondo__muestra--blanco" aria-hidden="true"></i>Blanco</span>
  </label>
  <label class="selector-fondo__op">
    <input type="radio" name="fondo-pagina" value="verdoso" />
    <span><i class="selector-fondo__muestra selector-fondo__muestra--verdoso" aria-hidden="true"></i>Verdoso</span>
  </label>
</div>

<script>
  const html = document.documentElement;
  document.querySelectorAll<HTMLElement>('[data-selector-fondo]').forEach((grupo) => {
    const radios = [...grupo.querySelectorAll<HTMLInputElement>('input[name="fondo-pagina"]')];
    const marcar = () => radios.forEach((r) => (r.checked = r.value === html.dataset.fondo));
    marcar();
    radios.forEach((r) => r.addEventListener('change', () => {
      html.dataset.fondo = r.value;
      try { localStorage.setItem('copol-fondo', r.value); } catch { /* almacenamiento no disponible */ }
      document.querySelectorAll<HTMLInputElement>('input[name="fondo-pagina"]').forEach((x) => (x.checked = x.value === r.value));
    }));
  });
</script>

<style>
  .selector-fondo { display: inline-flex; align-items: center; gap: 4px; padding: 3px; border-radius: var(--radio-pill); background: rgb(255 255 255 / 0.14); }
  .selector-fondo__titulo { padding-inline: 8px 2px; font-weight: 700; font-size: 0.8125rem; opacity: 0.9; }
  .selector-fondo__op { position: relative; }
  .selector-fondo__op input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .selector-fondo__op span {
    display: inline-flex; align-items: center; gap: 6px; min-height: 30px; padding: 3px 10px; border-radius: var(--radio-pill);
    font-size: 0.8125rem; font-weight: 600; color: var(--blanco); cursor: pointer; transition: background var(--transicion), color var(--transicion);
  }
  .selector-fondo__op input:checked + span { background: var(--blanco); color: var(--verde-oscuro); }
  .selector-fondo__op input:focus-visible + span { outline: 2px solid var(--amarillo-copol); outline-offset: 1px; }
  .selector-fondo__muestra { width: 12px; height: 12px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgb(0 51 26 / 0.35); }
  .selector-fondo__muestra--blanco { background: #ffffff; }
  .selector-fondo__muestra--verdoso { background: #eaf4ee; }
  @media (max-width: 479px) { .selector-fondo__titulo { display: none; } }
</style>
