---
// Aperturas de crédito (server island: se genera en el servidor y la CDN la guarda hasta el próximo cambio).
// Las fechas se cargan en el panel (Administración Página → Créditos); solo se muestran las de hoy en
// adelante (hora de Uruguay), así que una fecha pasada desaparece sola sin volver a publicar el sitio.
// Se usa con server:defer y un hueco del mismo tamaño como fallback (ver .creditos-esqueleto en global.css).
import { hoyUruguay, leerAperturas, partesFecha, proximas } from '../lib/contenido';
import { cachearEnCdn, ETIQUETAS_WEB, sinCache } from '../lib/cache-publica';
import Icono from './Icono.astro';
import Button from './ui/Button.astro';
import Badge from './ui/Badge.astro';

const { valor, enVivo } = await leerAperturas();
if (enVivo) cachearEnCdn(Astro.response.headers, ETIQUETAS_WEB.creditos);
else sinCache(Astro.response.headers);
const hoy = hoyUruguay();
const aperturas = proximas(valor, hoy).map((a) => ({ ...a, ...partesFecha(a.fecha), iso: a.fecha }));
const anio = hoy.slice(0, 4);
---
<section class="contenedor creditos" aria-labelledby="creditos-titulo">
  <div class="creditos__caja sobre-verde">
    <div class="creditos__texto">
      <h2 id="creditos-titulo">Aperturas de crédito</h2>
      <p><strong>Lo que queda de {anio}.</strong> Consultá tu crédito disponible desde Acceso web o acercate a cualquiera de nuestros locales.</p>
    </div>
    {aperturas.length > 0 ? (
      <ul class="creditos__fechas">
        {aperturas.map((a, i) => (
          <li class="creditos__fecha" style={`--i: ${i}`}>
            <time datetime={a.iso}>
              <span class="creditos__dia">{a.dia}</span>
              <span class="creditos__mes">{a.mes}</span>
            </time>
            {!a.confirmada && <Badge variant="accent">Fecha a confirmar</Badge>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="creditos__vacio">
        <Badge variant="accent">Fecha a confirmar</Badge>
        <span>Las próximas aperturas se publicarán aquí.</span>
      </p>
    )}
    <Button href="/acceso-web/" variant="accent">
      <Icono nombre="candado" tamano={18} /> Consultá tu crédito
    </Button>
  </div>
</section>

<style>
  .creditos { padding-top: var(--seccion); }
  .creditos__caja {
    background: var(--tinta-campo);
    color: var(--blanco);
    border-radius: var(--radio-xl);
    padding: clamp(28px, 4vw, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: 24px 36px;
    align-items: center;
    justify-content: space-between;
  }
  .creditos__texto { flex: 1 1 320px; display: grid; gap: 8px; }
  @media (max-width: 599px) {
    .creditos__caja > :global(.btn) { flex: 1 1 100%; }
    .creditos__fechas { width: 100%; }
    .creditos__fecha { flex: 1 1 0; min-width: 0; padding-inline: 12px; }
  }
  .creditos__texto h2 { color: var(--blanco); }
  .creditos__texto p { color: var(--sobre-verde); max-width: 52ch; }
  .creditos__texto strong { color: var(--blanco); }
  .creditos__fechas { display: flex; flex-wrap: wrap; gap: 14px; list-style: none; margin: 0; padding: 0; }
  .creditos__fecha {
    background: var(--blanco);
    color: var(--verde-oscuro);
    border-radius: var(--radio-lg);
    padding: 16px 26px;
    min-width: 136px;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .creditos__fecha time { display: grid; justify-items: center; }
  .creditos__dia { font-family: var(--fuente-titulo); font-stretch: var(--titulo-ancho); font-size: 2.75rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
  .creditos__mes { font-weight: 700; }
  .creditos__vacio { display: grid; gap: 8px; justify-items: start; color: var(--sobre-verde); }
  /* Las fechas entran como fichas, una tras otra, con un resorte leve. */
  :global(.js-animar) .creditos__fecha {
    opacity: 0;
    transform: translateY(18px) scale(0.92);
    transition: opacity 500ms var(--ease-out-quart), transform 900ms var(--resorte);
    transition-delay: calc(250ms + var(--i, 0) * 110ms);
  }
  :global(.js-animar) .creditos__caja:global(.visible) .creditos__fecha { opacity: 1; transform: none; }

  /* Afiche: las fechas son tiras de papel impresas con numerales condensados enormes. */
  :global(:root[data-estilo='afiche']) .creditos__fecha { border-radius: 0; background: var(--papel); padding: 14px 22px 12px; min-width: 128px; }
  :global(:root[data-estilo='afiche']) .creditos__dia { font-size: 4.25rem; line-height: 0.86; }
  :global(:root[data-estilo='afiche']) .creditos__mes { text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.875rem; }
  /* Folleto: caja verde con borde amarillo grueso y fechas como sellos redondos amarillos. */
  :global(:root[data-estilo='folleto']) .creditos__caja { box-shadow: inset 0 0 0 6px var(--amarillo-copol); }
  :global(:root[data-estilo='folleto']) .creditos__fecha {
    width: 136px; aspect-ratio: 1; min-width: 0; padding: 0; place-content: center; border-radius: 50%;
    background: var(--amarillo-copol); color: var(--verde-oscuro); rotate: -4deg;
  }
  :global(:root[data-estilo='folleto']) .creditos__fecha:nth-child(even) { rotate: 3deg; }
  @media (max-width: 599px) {
    :global(:root[data-estilo='folleto']) .creditos__fecha { width: auto; flex: 1 1 0; max-width: 150px; }
  }
</style>
