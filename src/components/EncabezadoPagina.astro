---
// Cabecera de páginas secundarias: migas, antetítulo (si no repite las migas), H1 (sube desde una máscara), bajada,
// acciones e imagen opcional. La imagen conserva su proporción (sin recortes forzados).
import type { ImageMetadata } from 'astro';
import Migas from './Migas.astro';
import Media from './ui/Media.astro';

interface Props {
  titulo: string;
  antetitulo?: string;
  bajada?: string;
  migas: { texto: string; href?: string }[];
  imagen?: ImageMetadata;
  altImagen?: string;
  /** Recorte opcional (p. ej. "4/3") y posición del encuadre. */
  ratioImagen?: string;
  posicionImagen?: string;
}
const { titulo, antetitulo, bajada, migas, imagen, altImagen = '', ratioImagen, posicionImagen } = Astro.props;
// El antetítulo no repite lo que ya dicen las migas ("Beneficios", "Hipermercado · Bazar"…): solo queda la parte
// que aporta algo propio, como "Desde 1917" o "Abierto a todo público".
const normalizar = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
const enMigas = new Set([...migas.map((m) => normalizar(m.texto)), normalizar(titulo)]);
const antetituloPropio = antetitulo?.split(' · ').filter((p) => !enMigas.has(normalizar(p))).join(' · ');
---
<section class="cabecera sobre-verde">
  <div class="contenedor">
    <Migas items={migas} />
    <div class:list={['cabecera__cuerpo', { 'cabecera__cuerpo--imagen': imagen }]}>
      <div class="cabecera__texto">
        {antetituloPropio && <span class="eyebrow">{antetituloPropio}</span>}
        <h1 class="cabecera__titulo"><span>{titulo}</span></h1>
        {bajada && <p class="lead">{bajada}</p>}
        {Astro.slots.has('default') && <div class="cabecera__acciones"><slot /></div>}
      </div>
      {imagen && (
        <Media
          src={imagen}
          alt={altImagen}
          ratio={ratioImagen}
          posicion={posicionImagen}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 900px) 560px, 100vw"
          prioridad
          radio="96px var(--radio-xl) var(--radio-xl) var(--radio-xl)"
          class="cabecera__imagen"
        />
      )}
    </div>
  </div>
</section>

<style>
  .cabecera {
    border-bottom: 1px solid var(--border);
    padding-block: clamp(16px, 3vw, 28px) clamp(40px, 6vw, 72px);
  }
  .cabecera__cuerpo {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: clamp(16px, 3vw, 32px);
  }
  @media (min-width: 900px) {
    .cabecera__cuerpo--imagen { grid-template-columns: 1.05fr 1fr; }
  }
  .cabecera__texto { display: grid; gap: 16px; justify-items: start; }
  .cabecera__titulo { overflow: hidden; padding-bottom: 0.18em; margin-bottom: -0.18em; }
  .cabecera__titulo > span { display: block; }
  @media (prefers-reduced-motion: no-preference) {
    .cabecera__titulo > span { animation: subir 900ms var(--ease-out-quart) both; }
    .cabecera__texto > :not(.cabecera__titulo) { animation: entrar 700ms var(--ease-out-quart) both; animation-delay: 120ms; }
    .cabecera :global(.cabecera__imagen) { animation: entrar 900ms var(--ease-out-quart) both; animation-delay: 80ms; }
  }
  @keyframes subir { from { transform: translateY(105%); } to { transform: none; } }
  @keyframes entrar { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  .cabecera__acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
  .cabecera :global(.cabecera__imagen) { width: 100%; max-height: 460px; }
  @media (max-width: 899px) {
    .cabecera :global(.cabecera__imagen) { --media-radio: 56px var(--radio-lg) var(--radio-lg) var(--radio-lg) !important; }
  }

  /* Cabecera verde (tomada del rediseño del 28/10/2026): bloque Verde oscuro de borde a borde, como el banner
     principal de Inicio, con el título en el color del fondo de la página y los textos en verde claro. */
  .cabecera { background: var(--verde-oscuro); color: var(--sobre-verde); border-bottom: 0; }
  .cabecera .cabecera__titulo { color: var(--fondo-pagina); }
  .cabecera :global(.lead) { color: var(--sobre-verde); }
  .cabecera .eyebrow { color: var(--amarillo-copol); }
  .cabecera :global(.migas ol),
  .cabecera :global(.migas a),
  .cabecera :global(.migas [aria-current]) { color: var(--sobre-verde); }
  .cabecera :global(.migas a:hover) { color: var(--blanco); }
  .cabecera :global(.migas li + li::before) { color: rgb(255 255 255 / 0.4); }
  /* Botones sobre el verde: el principal en color papel y los de contorno en claro. */
  .cabecera :global(.btn--default) { background: var(--fondo-pagina); color: var(--verde-oscuro); }
  .cabecera :global(.btn--default:hover) { background: var(--blanco); color: var(--verde-oscuro); }
  .cabecera :global(:is(.btn--outline, .btn--secondary)) { background: transparent; color: var(--blanco); border-color: rgb(255 255 255 / 0.7); }
  .cabecera :global(:is(.btn--outline, .btn--secondary):hover) { background: var(--fondo-pagina); color: var(--verde-oscuro); border-color: var(--fondo-pagina); }
</style>
