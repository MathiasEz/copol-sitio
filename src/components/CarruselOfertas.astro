---
// Carrusel de ofertas del supermercado (piezas 4:5 con precio): cinta continua.
// - Las piezas se deslizan solas, de forma continua y en bucle sin cortes (se duplican como copias
//   decorativas). La velocidad depende del ancho de cada pieza: cada una tarda ~5 s en pasar.
// - Con el puntero encima (o el foco del teclado) la cinta frena con suavidad hasta detenerse y retoma
//   con la misma suavidad al salir. La pieza bajo el puntero se eleva.
// - Se puede arrastrar con el mouse o deslizar con el dedo (con inercia), usar las flechas ←/→ con la
//   cinta enfocada. Sin botones de avanzar ni pausar (pedido de la cooperativa): se detiene con el puntero,
//   con el foco del teclado y mientras se arrastra.
// - Con prefers-reduced-motion no avanza sola. Sin JS: fila desplazable con encastre.
// - Es un elemento personalizado (<copol-ofertas>): se activa aunque su HTML llegue después de cargar la
//   página (en Promociones va dentro de una server island). Las piezas se cargan en el panel
//   (Administración Página → Ofertas).
interface Props {
  /** grande: imagen para el visor ampliado (src/components/Visor.astro). */
  piezas: { src: string; srcset?: string; grande?: string; alt: string }[];
  titulo: string;
}
const { piezas, titulo } = Astro.props;
---
<copol-ofertas class="ofertas" data-ofertas role="region" aria-roledescription="carrusel" aria-label={titulo}>
  <div class="ofertas__ventana" data-ventana tabindex="0" aria-label="Ofertas: se desplazan solas; pasá el mouse para detenerlas, usá las flechas izquierda y derecha o Enter para verlas en grande">
    <ul class="ofertas__pista" data-pista>
      {piezas.map((p, i) => (
        <li class="oferta" aria-roledescription="diapositiva" data-visor data-visor-grupo="ofertas" data-visor-i={i} data-visor-src={p.grande ?? p.src} data-visor-alt={p.alt}>
          <img
            src={p.src}
            srcset={p.srcset}
            sizes="(min-width: 1200px) 280px, (min-width: 900px) 24vw, (min-width: 600px) 36vw, 72vw"
            alt={p.alt}
            width="800"
            height="1000"
            loading={i < 5 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
            class="oferta__img"
          />
        </li>
      ))}
    </ul>
  </div>
  <p class="ofertas__ayuda" data-ayuda hidden>{piezas.length} ofertas · pasá el mouse por encima para detenerlas y tocá una para verla en grande</p>
</copol-ofertas>

<script>
  const iniciar = (raiz: HTMLElement) => {
    const ventana = raiz.querySelector<HTMLElement>('[data-ventana]')!;
    const pista = raiz.querySelector<HTMLElement>('[data-pista]')!;
    const originales = [...pista.children] as HTMLElement[];
    if (originales.length < 2) return;
    const SEGUNDOS_POR_PIEZA = 5;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)');

    // Copias para el bucle (decorativas: ocultas para lectores de pantalla y fuera del orden de tabulación).
    for (let vuelta = 0; vuelta < 2; vuelta++) {
      originales.forEach((li) => {
        const copia = li.cloneNode(true) as HTMLElement;
        copia.setAttribute('aria-hidden', 'true');
        copia.removeAttribute('aria-label');
        copia.querySelectorAll('img').forEach((img) => { img.alt = ''; img.loading = 'lazy'; });
        pista.append(copia);
      });
    }
    raiz.classList.add('ofertas--js');
    raiz.querySelector<HTMLElement>('[data-ayuda]')!.hidden = false;

    const paso = () => (pista.children[1] as HTMLElement).offsetLeft - (pista.children[0] as HTMLElement).offsetLeft;
    const anchoSet = () => (pista.children[originales.length] as HTMLElement).offsetLeft - (pista.children[0] as HTMLElement).offsetLeft;

    let x = 0;            // desplazamiento actual (px)
    let v = 0;            // velocidad actual (px/s): se acerca de a poco a la velocidad objetivo
    let encima = false;
    let foco = false;
    let arrastre: { id: number; x0: number; xInicio: number; ultimoX: number; ultimoT: number; vel: number } | null = null;
    let inercia = 0;      // velocidad residual tras soltar (px/s)
    let salto: { desde: number; hasta: number; t0: number; dur: number } | null = null;
    let ultimo = 0;

    const objetivo = () => (reducido.matches || encima || foco || arrastre || document.hidden ? 0 : paso() / SEGUNDOS_POR_PIEZA);
    const envolver = () => {
      const set = anchoSet();
      if (set <= 0) return;
      while (x >= set) x -= set;
      while (x < 0) x += set;
    };
    const pintar = () => { pista.style.transform = `translate3d(${-x}px, 0, 0)`; };
    const easeOutQuart = (t: number) => 1 - (1 - t) ** 4;

    const cuadro = (t: number) => {
      const dt = ultimo ? Math.min((t - ultimo) / 1000, 0.1) : 0;
      ultimo = t;
      if (salto) {
        const p = Math.min(1, (t - salto.t0) / salto.dur);
        x = salto.desde + (salto.hasta - salto.desde) * easeOutQuart(p);
        if (p >= 1) salto = null;
      } else if (!arrastre) {
        // Aceleración y frenado suaves (~0,7 s) en vez de cortes bruscos.
        v += (objetivo() - v) * (1 - Math.exp(-dt * 4));
        if (Math.abs(inercia) > 1) {
          x += inercia * dt;
          inercia *= Math.exp(-dt * 3.5);
        } else inercia = 0;
        x += v * dt;
      }
      envolver();
      pintar();
      requestAnimationFrame(cuadro);
    };

    const saltar = (dir: 1 | -1) => {
      const p = paso();
      inercia = 0;
      // Alinea al borde de la pieza más cercana en la dirección elegida.
      const base = dir > 0 ? Math.floor(x / p + 0.05) * p : Math.ceil(x / p - 0.05) * p;
      salto = { desde: x, hasta: base + dir * p, t0: performance.now(), dur: reducido.matches ? 1 : 650 };
    };
    ventana.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); saltar(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); saltar(-1); }
      // Enter abre en grande la pieza que está primera a la vista.
      if (e.key === 'Enter') {
        e.preventDefault();
        (window as unknown as { copolVisor?: { abrirGrupo: (g: string, i: number) => void } }).copolVisor?.abrirGrupo('ofertas', Math.round(x / paso()) % originales.length);
      }
    });

    // Pausa al pasar el mouse (solo puntero fino: en pantallas táctiles no hay "encima").
    ventana.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') encima = true; });
    ventana.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') encima = false; });
    ventana.addEventListener('focusin', () => { foco = ventana.matches(':focus-visible'); });
    ventana.addEventListener('focusout', () => { foco = false; });

    // Arrastre con el mouse o deslizamiento con el dedo (el desplazamiento vertical de la página sigue libre).
    ventana.addEventListener('pointerdown', (e) => {
      delete raiz.dataset.arrastrado;
      if (e.button !== 0) return;
      salto = null; inercia = 0; v = 0;
      arrastre = { id: e.pointerId, x0: e.clientX, xInicio: x, ultimoX: e.clientX, ultimoT: performance.now(), vel: 0 };
    });
    ventana.addEventListener('pointermove', (e) => {
      if (!arrastre || e.pointerId !== arrastre.id) return;
      const dx = e.clientX - arrastre.x0;
      if (Math.abs(dx) > 4 && !ventana.hasPointerCapture(e.pointerId)) {
        ventana.setPointerCapture(e.pointerId);
        raiz.dataset.arrastrado = '1'; // el clic al soltar no abre el visor
        raiz.classList.add('ofertas--arrastrando');
      }
      const ahora = performance.now();
      const dt = (ahora - arrastre.ultimoT) / 1000;
      if (dt > 0) arrastre.vel = 0.8 * ((arrastre.ultimoX - e.clientX) / dt) + 0.2 * arrastre.vel;
      arrastre.ultimoX = e.clientX; arrastre.ultimoT = ahora;
      x = arrastre.xInicio - dx;
    });
    const soltar = (e: PointerEvent) => {
      if (!arrastre || e.pointerId !== arrastre.id) return;
      inercia = Math.max(-2500, Math.min(2500, arrastre.vel));
      arrastre = null;
      raiz.classList.remove('ofertas--arrastrando');
    };
    ventana.addEventListener('pointerup', soltar);
    ventana.addEventListener('pointercancel', soltar);
    ventana.addEventListener('lostpointercapture', soltar);
    ventana.addEventListener('dragstart', (e) => e.preventDefault());

    requestAnimationFrame(cuadro);
  };
  if (!customElements.get('copol-ofertas')) {
    customElements.define('copol-ofertas', class extends HTMLElement {
      connectedCallback() {
        if (this.dataset.listo) return;
        this.dataset.listo = '1';
        iniciar(this);
      }
    });
  }
</script>

<!-- Globales: el componente se muestra dentro de una server island. -->
<style is:global>
  .ofertas { position: relative; display: grid; gap: 16px; }
  .ofertas__ventana {
    overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none;
    border-radius: var(--radio-lg);
  }
  .ofertas__ventana::-webkit-scrollbar { display: none; }
  .ofertas__ventana:focus-visible { outline: 3px solid var(--ring); outline-offset: 4px; }
  .ofertas__pista {
    list-style: none; margin: 0; padding: 14px 2px 18px; display: grid; grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 18px) / 4); gap: 18px;
  }
  @media (max-width: 1099px) { .ofertas__pista { grid-auto-columns: calc((100% - 2 * 16px) / 3); gap: 16px; } }
  @media (max-width: 759px) { .ofertas__pista { grid-auto-columns: calc((100% - 14px) / 2); gap: 14px; } }
  @media (max-width: 479px) { .ofertas__pista { grid-auto-columns: 72%; } }
  .oferta { scroll-snap-align: start; min-width: 0; }
  .oferta .oferta__img {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover;
    border-radius: var(--radio-lg); box-shadow: var(--anillo), var(--sombra-suave); background: #f3c3dc;
    user-select: none; -webkit-user-drag: none;
  }

  /* ── Con JS: cinta continua ── */
  .ofertas--js .ofertas__ventana {
    overflow: hidden; scroll-snap-type: none; touch-action: pan-y; cursor: grab;
    /* Bordes que se desvanecen: las piezas entran y salen sin corte seco. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .ofertas--js .ofertas__pista { will-change: transform; }
  .ofertas--js .oferta { cursor: zoom-in; }
  .ofertas--arrastrando .ofertas__ventana, .ofertas--arrastrando .oferta { cursor: grabbing; }
  .ofertas--js .oferta { scroll-snap-align: none; }
  @media (prefers-reduced-motion: no-preference) {
    .ofertas--js .oferta .oferta__img {
      transition: transform 500ms var(--resorte), box-shadow 400ms var(--ease-out-quart), filter 400ms var(--ease-out-quart);
    }
    @media (hover: hover) and (pointer: fine) {
      /* La pieza bajo el puntero se eleva; las demás bajan apenas el brillo para darle protagonismo. */
      .ofertas--js .ofertas__ventana:hover .oferta .oferta__img { filter: saturate(0.85) brightness(0.97); }
      .ofertas--js .ofertas__ventana:hover .oferta:hover .oferta__img {
        transform: translateY(-8px) scale(1.02); filter: none;
        box-shadow: var(--anillo), 0 24px 40px -18px rgb(0 51 26 / 0.45);
      }
    }
  }

  .ofertas__ayuda { font-size: 0.875rem; font-weight: 600; color: var(--muted-foreground); }
  @media (hover: none) { .ofertas__ayuda { display: none; } }
</style>
