---
<svg
  class={clase}
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={etiqueta ? undefined : 'true'}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  focusable="false"
  set:html={nombre === 'pausa' || nombre === 'play' ? ICONOS[nombre].replace(/<(rect|path)/g, '<$1 fill="currentColor" stroke="none"') : ICONOS[nombre]}
/>
