---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { NAVEGACION } from '../data/navegacion';
import Button from '../components/ui/Button.astro';
---
<Base titulo="Página no encontrada" noIndexar>
  <section class="contenedor seccion error">
    <h1>No encontramos esta página</h1>
    <p class="lead">Puede que la dirección haya cambiado con el nuevo sitio. Te dejamos los accesos principales:</p>
    <ul class="error__enlaces">
      {NAVEGACION.map((n) => <li><Button href={n.href} variant="secondary">{n.texto}</Button></li>)}
      <li><Button href="/acceso-web/" variant="accent"><Icono nombre="candado" tamano={18} /> Acceso web</Button></li>
    </ul>
  </section>
</Base>

<style>
  .error { display: grid; gap: 16px; justify-items: start; min-height: 50vh; align-content: center; }
  .error__enlaces { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
</style>
