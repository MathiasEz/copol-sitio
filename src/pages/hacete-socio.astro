---
import Base from '../layouts/Base.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import AperturasCredito from '../components/AperturasCredito.astro';
import Icono from '../components/Icono.astro';
import { LOCALES } from '../lib/datos';
import { CONTACTO, whatsapp } from '../data/confirmado/sitio';
import { BENEFICIOS_SOCIO } from '../data/confirmado/beneficios-socio';
import { PREGUNTAS_SOCIO } from '../data/confirmado/hacete-socio';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Accordion from '../components/ui/Accordion.astro';

// Contenido: página "Cómo hacerte socio" del sitio anterior (revisada el 12/10/2026).
const ws = (m: string) => whatsapp(CONTACTO.whatsappSocios.numero, m);

const beneficios = BENEFICIOS_SOCIO.map((b) => (b.icono === 'ubicacion' ? { ...b, titulo: `${LOCALES.length} locales` } : b));

const preguntas = PREGUNTAS_SOCIO;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
<Base titulo="Hacete socio" descripcion="Cómo hacerte socio de COPOL: con el convenio de tu empresa o creando uno con 6 o más personas. Requisitos, preguntas frecuentes y contacto por WhatsApp.">
  <EncabezadoPagina
    titulo="Te asociás y ya sos parte"
    antetitulo="Hacete socio"
    bajada="Ser socio de COPOL es más fácil de lo que pensás. Accedé a créditos, servicios sociales, convenios y mucho más."
    migas={[{ texto: 'Hacete socio' }]}
  >
    <Button href={ws('Hola, quiero info para asociarme')}><Icono nombre="whatsapp" tamano={18} /> Quiero asociarme</Button>
    <Button href="#como-funciona" variant="outline">Cómo funciona</Button>
  </EncabezadoPagina>

  <section class="contenedor seccion" aria-labelledby="beneficios-titulo">
    <h2 id="beneficios-titulo"><span class="mascara"><span>Qué ganás como socio</span></span></h2>
    <ul class="ventajas escalonar">
      {beneficios.map((b) => (
        <li>
          <Card href={b.href} class="ventaja">
            <span class="card__icono card__icono--accent"><Icono nombre={b.icono} tamano={26} /></span>
            <h3>{b.titulo}</h3>
            <p>{b.texto}</p>
          </Card>
        </li>
      ))}
    </ul>
  </section>

  <!-- Asistente para socios: una pregunta, tres respuestas y los pasos a seguir (sin JavaScript se ven todas las respuestas) -->
  <section class="seccion seccion--suave" id="como-funciona" aria-labelledby="caminos-titulo">
    <div class="contenedor guia" data-guia>
      <div class="guia__intro">
        <h2 id="caminos-titulo">Descubrí tu camino para asociarte</h2>
        <p class="lead">Sea cual sea tu situación, hay un camino para que formes parte de COPOL. Respondé una pregunta y te mostramos cómo seguir.</p>
        <div class="guia__pregunta" role="group" aria-labelledby="guia-pregunta">
          <p id="guia-pregunta" class="guia__enunciado">¿Tu empresa o institución tiene convenio con COPOL?</p>
          <div class="guia__opciones">
            <button type="button" class="guia__opcion" data-opcion="si" aria-pressed="false"><Icono nombre="check" tamano={22} /><strong>Sí, tiene convenio</strong><span>Me asocio directamente</span></button>
            <button type="button" class="guia__opcion" data-opcion="no" aria-pressed="false"><Icono nombre="usuarios" tamano={22} /><strong>No tiene convenio</strong><span>Quiero crearlo</span></button>
            <button type="button" class="guia__opcion" data-opcion="nose" aria-pressed="false"><Icono nombre="buscar" tamano={22} /><strong>No sé si tiene</strong><span>Quiero averiguarlo</span></button>
          </div>
        </div>
      </div>

      <div class="guia__resultados" aria-live="polite" data-guia-resultados>
        <p class="guia__vacio" data-guia-vacio hidden><Icono nombre="flecha" tamano={22} /> Elegí una opción para ver tus pasos.</p>

        <article class="resultado resultado--si" data-resultado="si">
          <Badge variant="default">¿Tenés convenio? Sí</Badge>
          <h3>Te asociás directamente</h3>
          <ol class="resultado__pasos">
            <li>Tu institución o empresa ya tiene convenio con COPOL.</li>
            <li>Comunicate con nosotros.</li>
            <li>Verificamos tu situación y te damos de alta.</li>
          </ol>
          <Button href={ws('Hola, quiero info para asociarme (tengo convenio)')} size="lg"><Icono nombre="whatsapp" tamano={18} /> Asociate ahora <Icono nombre="flecha" tamano={18} /></Button>
        </article>

        <article class="resultado resultado--no" data-resultado="no">
          <Badge variant="accent">¿Tenés convenio? No</Badge>
          <h3>Creá el convenio</h3>
          <ol class="resultado__pasos">
            <li>Reúnan 6 o más personas de la misma empresa o institución.</li>
            <li>Escribinos por WhatsApp.</li>
            <li>Nosotros nos encargamos del resto.</li>
          </ol>
          <Button href={ws('Hola, quiero info para crear un convenio')} variant="accent" size="lg"><Icono nombre="whatsapp" tamano={18} /> Creá tu convenio <Icono nombre="flecha" tamano={18} /></Button>
        </article>

        <article class="resultado resultado--nose" data-resultado="nose">
          <Badge variant="outline">¿Tenés convenio? Averiguá</Badge>
          <h3>Consultá si tu empresa tiene convenio</h3>
          <ol class="resultado__pasos">
            <li>Escribinos con el nombre de tu empresa o institución.</li>
            <li>Verificamos si ya tiene convenio con COPOL.</li>
            <li>Si lo tiene, te asociás directamente; si no, pueden crearlo con 6 o más personas.</li>
          </ol>
          <Button href={ws('Hola, quiero saber si mi empresa tiene convenio con COPOL')} size="lg"><Icono nombre="whatsapp" tamano={18} /> Consultanos <Icono nombre="flecha" tamano={18} /></Button>
        </article>
      </div>
    </div>
  </section>

  <section class="contenedor seccion faq" aria-labelledby="faq-titulo">
    <div>
      <h2 id="faq-titulo">Preguntas frecuentes</h2>
      <p class="lead">¿Otra consulta? Escribinos al <a href={ws('Hola, tengo una consulta para asociarme')} rel="noopener">{CONTACTO.whatsappSocios.texto}</a>.</p>
    </div>
    <Accordion items={preguntas.map((q) => ({ titulo: q.p, contenido: q.r }))} />
  </section>

  <!-- Fechas de crédito: se cargan en el panel; las pasadas se ocultan solas -->
  <AperturasCredito server:defer>
    <div slot="fallback" class="contenedor creditos-esqueleto" aria-hidden="true"><div></div></div>
  </AperturasCredito>

  <section class="contenedor seccion" aria-labelledby="final-titulo">
    <div class="final sobre-verde">
      <h2 id="final-titulo">Más de 36.000 socios ya disfrutan de COPOL</h2>
      <p>No te quedes afuera: hacete socio hoy y empezá a disfrutar de todos los beneficios.</p>
      <div class="final__acciones">
        <Button href={ws('Hola, quiero info para asociarme')} variant="accent"><Icono nombre="whatsapp" tamano={18} /> Escribinos al {CONTACTO.whatsappSocios.texto}</Button>
        <Button href={`tel:+${CONTACTO.whatsappSocios.numero}`} variant="inverse"><Icono nombre="telefono" tamano={18} /> Llamar</Button>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Base>

<script>
  // Asistente para socios: muestra los pasos de la opción elegida (sin JavaScript se ven todas).
  const guia = document.querySelector<HTMLElement>('[data-guia]');
  if (guia) {
    guia.classList.add('guia--activa');
    const opciones = [...guia.querySelectorAll<HTMLButtonElement>('[data-opcion]')];
    const resultados = [...guia.querySelectorAll<HTMLElement>('[data-resultado]')];
    const vacio = guia.querySelector<HTMLElement>('[data-guia-vacio]')!;
    vacio.hidden = false;
    resultados.forEach((r) => (r.hidden = true));
    const elegir = (id: string) => {
      opciones.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.opcion === id)));
      vacio.hidden = true;
      resultados.forEach((r) => {
        const activo = r.dataset.resultado === id;
        r.hidden = !activo;
        if (activo) { r.classList.remove('resultado--entra'); void r.offsetWidth; r.classList.add('resultado--entra'); }
      });
      if (matchMedia('(max-width: 899px)').matches) guia.querySelector('[data-guia-resultados]')!.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    opciones.forEach((o) => o.addEventListener('click', () => elegir(o.dataset.opcion!)));
  }
</script>

<style>
  /* Cuatro ventajas parejas: 1 → 2 → 4 columnas (antes alternaban verde, blanco y amarillo sin motivo). */
  .ventajas { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .ventajas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .ventajas { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ventajas > li { display: flex; }
  .ventajas :global(.ventaja) { flex: 1; gap: 8px; }

  /* Asistente para socios */
  .guia { display: grid; gap: clamp(24px, 4vw, 48px); align-items: start; }
  @media (min-width: 900px) { .guia { grid-template-columns: 1fr 1fr; } }
  .guia__intro { display: grid; gap: 14px; }
  .guia__pregunta { display: grid; gap: 14px; margin-top: 8px; padding: clamp(18px, 2.4vw, 26px); border-radius: var(--radio-xl); background: var(--blanco); border: var(--card-borde); box-shadow: var(--card-sombra); }
  .guia__enunciado { display: flex; gap: 12px; align-items: center; margin: 0; font-weight: 800; font-size: 1.1875rem; color: var(--verde-oscuro); }
  .guia__opciones { display: grid; gap: 10px; }
  .guia__opcion {
    display: grid; grid-template-columns: auto 1fr; column-gap: 14px; align-items: center; text-align: left; font: inherit; cursor: pointer;
    padding: 14px 18px; border-radius: var(--radio-lg); border: 2px solid var(--borde); background: var(--background); color: var(--foreground);
    transition: transform 350ms var(--resorte), border-color var(--transicion), background-color var(--transicion), box-shadow 250ms var(--ease-out-quart);
  }
  .guia__opcion :global(svg) { grid-row: span 2; width: 44px; height: 44px; padding: 11px; border-radius: var(--radio-md); background: var(--muted); color: var(--verde-oscuro); transition: background-color var(--transicion), color var(--transicion); }
  .guia__opcion strong { font-size: 1.0625rem; }
  .guia__opcion span { color: var(--muted-foreground); font-size: 0.9375rem; }
  .guia__opcion:hover { transform: translateX(4px); border-color: var(--borde-fuerte); box-shadow: var(--sombra-suave); }
  .guia__opcion[aria-pressed='true'] { border-color: var(--verde-oscuro); background: var(--verde-oscuro); color: var(--sobre-verde); box-shadow: var(--sombra); transform: translateX(6px); }
  .guia__opcion[aria-pressed='true'] span { color: var(--sobre-verde); }
  .guia__opcion[aria-pressed='true'] :global(svg) { background: var(--amarillo-copol); color: var(--tinta); }
  .guia__resultados { display: grid; gap: 16px; align-content: start; }
  @media (min-width: 900px) { .guia__resultados, .guia__vacio { min-height: 320px; } }
  .guia__vacio { display: flex; gap: 12px; align-items: center; justify-content: center; margin: 0; padding: 24px; border-radius: var(--radio-xl); border: 2px dashed var(--borde-fuerte); color: var(--verde-oscuro); font-weight: 700; text-align: center; }
  .resultado {
    position: relative; display: grid; gap: 14px; justify-items: start; padding: clamp(24px, 3.4vw, 40px); border-radius: var(--radio-xl); overflow: hidden;
    background: var(--blanco); border: var(--card-borde); box-shadow: var(--sombra);
  }
  .resultado h3 { font-size: clamp(1.5rem, 2.8vw, 2rem); color: var(--verde-oscuro); }
  .resultado__pasos { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .resultado__pasos li { display: flex; gap: 12px; align-items: flex-start; font-size: 1.0625rem; }
  .resultado__pasos li::before { content: ''; flex: none; width: 10px; height: 10px; border-radius: 50%; background: var(--amarillo-copol); box-shadow: 0 0 0 4px var(--accent); margin: 9px 6px 0 6px; }
  .resultado__acciones { display: flex; flex-wrap: wrap; gap: 10px; }
  .resultado--si { border-top: 6px solid var(--verde-copol); }
  .resultado--no { border-top: 6px solid var(--amarillo-copol); }
  .resultado--nose { border-top: 6px solid var(--borde-fuerte); }
  .resultado--entra { animation: resultado-entra 520ms var(--ease-out-quart); }
  .resultado--entra .resultado__pasos li { animation: paso-entra 520ms var(--ease-out-quart) both; }
  .resultado--entra .resultado__pasos li:nth-child(2) { animation-delay: 90ms; }
  .resultado--entra .resultado__pasos li:nth-child(3) { animation-delay: 180ms; }
  @keyframes resultado-entra { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  @keyframes paso-entra { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .resultado--entra, .resultado--entra .resultado__pasos li { animation: none; } }
  /* Sin JavaScript no hay pregunta interactiva: la columna de la izquierda muestra solo el texto */
  .guia:not(.guia--activa) .guia__pregunta { display: none; }

  .faq { display: grid; gap: 28px; }
  @media (min-width: 900px) { .faq { grid-template-columns: 1fr 1.4fr; align-items: start; } }
  .faq > div:first-child { display: grid; gap: 12px; }

  .final { display: grid; gap: 14px; justify-items: center; text-align: center; padding: clamp(32px, 5vw, 64px); border-radius: var(--radio-xl); background: var(--tinta-campo); color: var(--sobre-verde); }
  .final p { margin-inline: auto; }
  /* Afiche: el cierre es un campo entintado a todo el ancho, con el título condensado grande. */
  :global(:root[data-estilo='afiche']) .final h2 { font-size: clamp(2.25rem, 5vw, 4.25rem); max-width: 18ch; }
  :global(:root[data-estilo='folleto']) .final { box-shadow: inset 0 0 0 6px var(--amarillo-copol); }
  .final h2 { color: var(--blanco); }
  .final__acciones { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 8px; }
</style>
