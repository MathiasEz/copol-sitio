---
import Base from '../../layouts/Base.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import Icono from '../../components/Icono.astro';
import { foto } from '../../lib/imagenes';
import { CONTACTO, HORARIOS, REDES, whatsapp } from '../../data/confirmado/sitio';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Media from '../../components/ui/Media.astro';

// Contenido: página "Tienda" del sitio anterior (revisada el 12/10/2026).
const rubros = [
  { nombre: 'Joyería', detalle: 'Anillos, cadenas, pulseras y más', icono: 'gema', tono: 'verde' },
  { nombre: 'Calzados', detalle: 'Marcas nacionales e importadas', icono: 'pasos', tono: 'amarillo' },
  { nombre: 'Indumentaria', detalle: 'Ropa para toda la familia', icono: 'camisa', tono: 'blanco' },
  { nombre: 'Perfumería', detalle: 'Perfumes importados de primera línea', icono: 'destellos', tono: 'oscuro' },
  { nombre: 'Óptica', detalle: 'Anteojos y lentes con asesoría', icono: 'ojo', tono: 'claro' },
] as const;
---
<Base titulo="Tienda" descripcion="Tienda COPOL en Casa Central: joyería, calzado, indumentaria, perfumería importada y óptica. Abierto a todo público, de lunes a domingo.">
  <EncabezadoPagina
    titulo="Nuestra Tienda"
    antetitulo="Hipermercado · Abierto a todo público"
    bajada="Joyería, calzado, indumentaria, perfumería importada y óptica: todo pensado para vos y tu familia. No necesitás ser socio para comprar."
    migas={[{ texto: 'Hipermercado', href: '/hipermercado/' }, { texto: 'Tienda' }]}
    imagen={foto('tienda-interior')}
    altImagen="Interior de la tienda de COPOL, con indumentaria y calzado en exhibición bajo un techo de lona"
  >
    <Button href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola, quiero consultar por la Tienda')}><Icono nombre="whatsapp" tamano={18} /> Consultá por WhatsApp</Button>
    <Button href={CONTACTO.casaCentral.mapa} variant="outline"><Icono nombre="ubicacion" tamano={18} /> Cómo llegar</Button>
  </EncabezadoPagina>

  <section class="contenedor seccion" aria-labelledby="rubros-titulo">
    <div class="encabezado-seccion">
      <div>
        <h2 id="rubros-titulo">Lo que podés encontrar</h2>
        <p class="lead">Recorré cada piso con acceso fácil y cómodo por escaleras mecánicas.</p>
      </div>
    </div>
    <ul class="rubros escalonar">
      {rubros.map((r) => (
        <li class={`rubro rubro--${r.tono}`}>
          <a href={whatsapp(CONTACTO.whatsappGeneral.numero, `Hola, quiero consultar por ${r.nombre} de la Tienda`)} rel="noopener">
            <span class="rubro__icono"><Icono nombre={r.icono} tamano={30} /></span>
            <span class="rubro__texto"><strong>{r.nombre}</strong><span>{r.detalle}</span></span>
            <span class="rubro__consulta">Consultá por WhatsApp <Icono nombre="flecha" tamano={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="seccion seccion--suave" aria-labelledby="horarios-titulo">
    <div class="contenedor info escalonar">
      <div class="card info__bloque info__bloque">
        <span class="info__icono"><Icono nombre="reloj" tamano={26} /></span>
        <h2 id="horarios-titulo">Horarios</h2>
        <dl>
          <dt>Tienda</dt>
          {HORARIOS.casaCentral.map((h) => <dd>{h.dias}: <strong>{h.horas}</strong></dd>)}
          <dt>Técnico óptico</dt>
          {HORARIOS.tecnicoOptico.map((h) => <dd>{h.dias}: <strong>{h.horas}</strong></dd>)}
        </dl>
      </div>
      <div class="card info__bloque info__bloque--visita">
        <span class="info__icono"><Icono nombre="ubicacion" tamano={26} /></span>
        <h2>Visitanos</h2>
        <p><strong>{CONTACTO.casaCentral.direccion}, {CONTACTO.casaCentral.ciudad}.</strong> {CONTACTO.casaCentral.accesoAlternativo}</p>
        <p>Acceso fácil con escaleras mecánicas y estacionamiento disponible.</p>
        <Badge variant="accent">Abierto a todo público</Badge>
      </div>
      <div class="card info__bloque info__bloque--insta">
        <span class="info__icono"><Icono nombre="instagram" tamano={26} /></span>
        <h2>Recorré el local</h2>
        <p>Mirá nuestra tienda y las novedades en Instagram.</p>
        <Button href={REDES.instagram} variant="outline"><Icono nombre="instagram" tamano={18} /> Ver en Instagram</Button>
      </div>
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="bazar-cta">
    <div class="cta-bazar grupo-hover aparecer">
      <Media src={foto('motos-bazar')} alt="" widths={[400, 640, 840]} sizes="(min-width: 900px) 420px, 100vw" />
      <div>
        <h2 id="bazar-cta">¿Buscás tecnología o artículos para el hogar?</h2>
        <p class="lead">Explorá el catálogo del Bazar y consultá stock por WhatsApp.</p>
        <Button href="/hipermercado/bazar/">Ver el Bazar <Icono nombre="flecha" tamano={18} /></Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Rubros: mosaico con un tratamiento distinto por tarjeta, hover con elevación y microanimaciones */
  .rubros { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) {
    .rubros { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; }
    .rubros > li { grid-column: span 2; }
    .rubros > li:nth-child(4), .rubros > li:nth-child(5) { grid-column: span 3; }
  }
  @media (max-width: 899px) { .rubros > li:first-child { grid-column: 1 / -1; } .rubros > li:last-child:nth-child(even) { grid-column: 1 / -1; } }
  .rubro a {
    position: relative; display: grid; gap: 18px; align-content: space-between; min-height: 210px; height: 100%; padding: clamp(20px, 2.4vw, 28px);
    border-radius: var(--radio-xl); text-decoration: none; overflow: hidden; isolation: isolate;
    box-shadow: var(--anillo);
      }
  .rubro a:hover { transform: translateY(-6px); box-shadow: var(--sombra); }
  .rubro a:active { transform: translateY(-2px) scale(0.99); }
  .rubro__icono { width: 60px; height: 60px; border-radius: var(--radio-md); display: grid; place-items: center; transition: transform 500ms var(--resorte); }
  .rubro a:hover .rubro__icono { transform: rotate(-8deg) scale(1.1); }
  .rubro__texto { display: grid; gap: 4px; }
  .rubro__texto strong { font-size: clamp(1.375rem, 2.2vw, 1.75rem); line-height: 1.1; }
  .rubro__texto span { font-size: 0.9375rem; }
  .rubro__consulta { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.875rem; opacity: 0.0; transform: translateY(6px); transition: opacity 300ms var(--ease-out-quart), transform 400ms var(--resorte); }
  .rubro a:hover .rubro__consulta, .rubro a:focus-visible .rubro__consulta { opacity: 1; transform: none; }
  @media (hover: none) { .rubro__consulta { opacity: 1; transform: none; } }

  /* Paleta sobria: tarjetas blancas con detalle amarillo; al pasar el puntero se llenan de verde de marca */
  .rubro a { background-color: var(--card); color: var(--tinta); }
  .rubro__icono { background: var(--accent); color: var(--tinta); }
  .rubro__texto strong { color: var(--verde-oscuro); }
  .rubro__texto span { color: var(--muted-foreground); }
  .rubro__consulta { color: var(--verde-oscuro); }
  .rubro a { background-image: linear-gradient(var(--verde-oscuro), var(--verde-oscuro)); background-repeat: no-repeat; background-size: 100% 0%; background-position: 0 100%; transition: transform 450ms var(--resorte), box-shadow 300ms var(--ease-out-quart), background-size 500ms var(--ease-out-quart), color 300ms; }
  .rubro a:hover { background-size: 100% 100%; background-position: 0 100%; }
  .rubro a:hover .rubro__texto strong, .rubro a:hover .rubro__consulta { color: var(--blanco); }
  .rubro a:hover .rubro__texto span { color: var(--sobre-verde); }

  .info { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .info__bloque { gap: 12px; align-items: flex-start; padding: 26px; border-radius: var(--radio-xl); transition: transform 450ms var(--resorte), box-shadow 300ms var(--ease-out-quart); }
  .info__bloque:hover { transform: translateY(-4px); box-shadow: var(--anillo-fuerte), var(--sombra-suave); }
  .info__icono { width: 50px; height: 50px; border-radius: var(--radio-md); display: grid; place-items: center; background: var(--muted); color: var(--verde-oscuro); transition: transform 450ms var(--resorte); }
  .info__bloque:hover .info__icono { transform: scale(1.08) rotate(-6deg); }
  .info__bloque h2 { font-size: 1.5rem; }
  .info__bloque dl { margin: 0; display: grid; gap: 4px; }
  .info__bloque dt { font-weight: 700; color: var(--verde-oscuro); margin-top: 8px; }
  .info__bloque dd { margin: 0; color: var(--tinta-suave); }
  .info__bloque dd strong { color: var(--tinta); }
  .cta-bazar { display: grid; gap: clamp(16px, 4vw, 48px); align-items: center; padding: 8px; border-radius: var(--radio-xl); background: var(--card); box-shadow: var(--anillo), var(--sombra-suave); }
  @media (min-width: 900px) { .cta-bazar { grid-template-columns: 440px 1fr; } }
  .cta-bazar > div { display: grid; gap: 14px; justify-items: start; padding: clamp(16px, 3vw, 32px); }
</style>
