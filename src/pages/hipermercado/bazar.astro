---
import Base from '../../layouts/Base.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import TarjetaModelo from '../../components/TarjetaModelo.astro';
import Icono from '../../components/Icono.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Campo from '../../components/ui/Campo.astro';
import Toggle from '../../components/ui/Toggle.astro';
import { obtenerCatalogoModelos } from '../../lib/inventario';
import { CONTACTO, whatsapp } from '../../data/confirmado/sitio';
import { cachearEnCdn, ETIQUETAS_WEB, sinCache } from '../../lib/cache-publica';

// Se genera en el servidor (no es una página estática): el stock sale de la misma base de datos que
// actualiza el panel. La CDN guarda la página y el panel la renueva al guardar un cambio, así un cambio
// guardado se ve en la próxima carga (src/lib/cache-publica.ts). Textos e imágenes del catálogo importado
// siguen guardados en el proyecto. Sin precios.
export const prerender = false;
// Los productos que son el mismo modelo en distintos colores se muestran juntos en una tarjeta
// (src/lib/variantes.ts); cada color conserva su código interno COPOL y su stock.
const catalogo = await obtenerCatalogoModelos();
const MODELOS = catalogo.modelos;
// Sin la base no hay stock confiable: esa versión no se guarda en la CDN.
if (catalogo.enVivo) cachearEnCdn(Astro.response.headers, ETIQUETAS_WEB.bazar);
else sinCache(Astro.response.headers);
const TOTALES_STOCK = catalogo.totales;
const secciones = catalogo.categorias.map((c) => ({ ...c, modelos: MODELOS.filter((m) => m.categoriaId === c.id) }));
---
<Base titulo="Bazar" descripcion={`Catálogo del Bazar COPOL: ${MODELOS.length} productos de tecnología, hogar, audio, bicicletas y más. Consultá stock y condiciones por WhatsApp.`}>
  <EncabezadoPagina
    titulo="Catálogo del Bazar"
    antetitulo="Hipermercado · Bazar"
    bajada="Tecnología, hogar, audio, bicicletas, cuidado personal y más. Consultá stock y condiciones de financiación por WhatsApp."
    migas={[{ texto: 'Hipermercado', href: '/hipermercado/' }, { texto: 'Bazar' }]}
  >
    <Button href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola! Quiero consultar por productos del Bazar COPOL')}><Icono nombre="whatsapp" tamano={18} /> Consultá por WhatsApp</Button>
  </EncabezadoPagina>

  <section class="contenedor catalogo" aria-labelledby="catalogo-titulo">
    <h2 id="catalogo-titulo" class="visualmente-oculto">Productos</h2>

    <form class="barra" data-filtros-bazar role="search" aria-label="Filtrar productos del Bazar" onsubmit="return false">
      <div class="barra__fila">
        <Campo etiqueta="Buscar producto" name="q" type="search" icono="buscar" placeholder="Freidora, iPhone, bicicleta, código…" autocomplete="off" class="barra__busqueda" />
        <fieldset class="toggle-group barra__stock">
          <legend class="label">Stock</legend>
          <Toggle name="stock" value="" checked contador={TOTALES_STOCK.total}>Todos</Toggle>
          <Toggle name="stock" value="con-stock" contador={TOTALES_STOCK.conStock}><span class="punto punto--con" aria-hidden="true"></span>Con stock</Toggle>
          <Toggle name="stock" value="sin-stock" contador={TOTALES_STOCK.sinStock}><span class="punto punto--sin" aria-hidden="true"></span>Sin stock</Toggle>
        </fieldset>
      </div>
      <fieldset class="toggle-group barra__categorias">
        <legend class="label">Categoría</legend>
        <Toggle name="categoria" value="" checked contador={MODELOS.length}>Todos los productos</Toggle>
        {secciones.map((c) => <Toggle name="categoria" value={c.id} contador={c.total}>{c.nombre}</Toggle>)}
      </fieldset>
    </form>

    {!catalogo.enVivo && (
      <div class="aviso-stock" role="status"><Icono nombre="info" tamano={18} /><p>En este momento no podemos mostrar el stock actualizado. Consultá la disponibilidad por WhatsApp.</p></div>
    )}

    <div class="estado">
      <p class="estado__texto" aria-live="polite" data-resultado>{MODELOS.length} productos en {secciones.length} categorías.</p>
      <button type="button" class="btn btn--ghost btn--sm" data-limpiar hidden>Limpiar filtros</button>
    </div>

    <div class="secciones" data-secciones>
      {secciones.map((s) => (
        <section class="seccion-cat" data-seccion={s.id} aria-labelledby={`cat-${s.id}`}>
          <header class="seccion-cat__cabecera">
            <h3 id={`cat-${s.id}`}>{s.nombre}</h3>
            <Badge variant="outline"><span><span data-contador>{s.total}</span> productos</span></Badge>
          </header>
          <div class="grilla-productos" data-grilla>
            {s.modelos.map((m, i) => <TarjetaModelo modelo={m} nivel="h4" cargaDiferida={!(s === secciones[0] && i < 4)} />)}
          </div>
        </section>
      ))}
    </div>

    <!-- Búsqueda escrita sin coincidencias -->
    <div class="vacio card card--dashed" data-vacio hidden>
      <span class="card__icono"><Icono nombre="buscar" tamano={24} /></span>
      <p class="vacio__titulo">No encontramos productos con esa búsqueda.</p>
      <p>Probá con otra palabra o escribinos: te conseguimos el producto que necesitás.</p>
      <Button href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola! Busco un producto que no encuentro en el catálogo del Bazar')}><Icono nombre="whatsapp" tamano={18} /> Consultá ahora</Button>
    </div>
    <!-- Combinación de filtros (sin búsqueda) que no tiene productos, p. ej. "Fitness" + "Sin stock" -->
    <div class="vacio card card--dashed" data-vacio-filtro hidden>
      <span class="card__icono"><Icono nombre="info" tamano={24} /></span>
      <p class="vacio__titulo" data-vacio-filtro-texto>No hay productos con esos filtros.</p>
      <button type="button" class="btn btn--outline" data-ver-todos>Ver todos los productos</button>
    </div>

    <!-- Ficha de producto: se completa con la tarjeta tocada; la descripción se pide al abrirla -->
    <dialog class="ficha" data-ficha aria-labelledby="ficha-titulo">
      <div class="ficha__caja">
        <div class="ficha__barra"><button type="button" class="ficha__cerrar" data-ficha-cerrar aria-label="Cerrar"><Icono nombre="cerrar" tamano={20} /></button></div>
        <div class="ficha__cabecera">
          <div class="ficha__imagen" data-ficha-imagen></div>
          <div class="ficha__titulos">
            <span class="producto__categoria" data-ficha-categoria></span>
            <h2 id="ficha-titulo" class="ficha__titulo" data-ficha-titulo></h2>
            <span class="ficha__resumen" data-ficha-resumen></span>
          </div>
        </div>
        <section class="ficha__seccion" aria-labelledby="ficha-var-titulo">
          <h3 id="ficha-var-titulo" class="ficha__subtitulo" data-ficha-var-titulo>Colores y stock</h3>
          <div data-ficha-variantes></div>
        </section>
        <section class="ficha__seccion" aria-labelledby="ficha-desc-titulo">
          <h3 id="ficha-desc-titulo" class="ficha__subtitulo">Descripción</h3>
          <div class="ficha__descripcion" data-ficha-descripcion></div>
          <p class="ficha__nota">Datos del catálogo, sujetos a cambios: confirmá especificaciones, colores y stock por WhatsApp.</p>
        </section>
      </div>
    </dialog>

    <!-- Carrito COPOL: se guarda solo en este navegador y se envía por WhatsApp (sin precios ni pagos) -->
    <button type="button" class="carrito-boton" data-carrito-abrir hidden aria-haspopup="dialog">
      <Icono nombre="carrito" tamano={20} /><span>Mi carrito</span><span class="carrito-boton__cuenta" data-carrito-cuenta>0</span>
    </button>
    <p class="carrito-aviso" role="status" aria-live="polite" data-carrito-aviso></p>
    <dialog class="ficha carrito" data-carrito aria-labelledby="carrito-titulo" data-wa={CONTACTO.whatsappGeneral.numero}>
      <div class="ficha__caja">
        <div class="ficha__barra"><button type="button" class="ficha__cerrar" data-carrito-cerrar aria-label="Cerrar"><Icono nombre="cerrar" tamano={20} /></button></div>
        <div class="carrito__cabecera">
          <h2 id="carrito-titulo" class="ficha__titulo"><Icono nombre="carrito" tamano={22} /> Tu carrito COPOL</h2>
          <p class="ficha__resumen" data-carrito-resumen></p>
        </div>
        <ul class="carrito__lista" data-carrito-lista></ul>
        <div class="carrito__vacio" data-carrito-vacio>
          <p>Todavía no agregaste productos. Abrí un producto con "Ver detalle" o "Ver colores y stock" y tocá <strong>Agregar</strong> en el color que quieras.</p>
        </div>
        <div class="carrito__pie" data-carrito-pie>
          <p class="ficha__nota">Al enviar se abre WhatsApp con tu pedido ya escrito para mandar a COPOL. El pedido queda confirmado solo cuando nuestro equipo lo gestiona por WhatsApp; el stock puede variar durante el día.</p>
          <div class="carrito__acciones">
            <button type="button" class="btn btn--ghost btn--sm" data-carrito-vaciar>Vaciar carrito</button>
            <a class="btn btn--default" href="#" target="_blank" rel="noopener" data-carrito-enviar><Icono nombre="whatsapp" tamano={18} /> Enviar por WhatsApp</a>
          </div>
        </div>
      </div>
    </dialog>

    <div class="aviso-legal">
      <p>Las imágenes son ilustrativas y pueden presentar diferencias con el producto real. Las características, colores y especificaciones técnicas están sujetos a cambios sin previo aviso.</p>
      <p>El estado de stock es orientativo y puede variar durante el día: confirmalo por WhatsApp. El pedido se considerará confirmado únicamente cuando haya sido gestionado por nuestro equipo a través de WhatsApp. La cooperativa no se responsabiliza por posibles errores tipográficos o de publicación.</p>
    </div>
  </section>

</Base>

<script>
  type Estado = 'con-stock' | 'sin-stock' | 'sin-dato';
  const ETIQUETA: Record<Estado, string> = { 'con-stock': 'Con stock', 'sin-stock': 'Sin stock', 'sin-dato': 'Consultar disponibilidad' };

  const form = document.querySelector<HTMLFormElement>('[data-filtros-bazar]')!;
  const secciones = [...document.querySelectorAll<HTMLElement>('[data-seccion]')];
  const resultado = document.querySelector<HTMLElement>('[data-resultado]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const vacioFiltro = document.querySelector<HTMLElement>('[data-vacio-filtro]')!;
  const vacioFiltroTexto = document.querySelector<HTMLElement>('[data-vacio-filtro-texto]')!;
  const limpiar = document.querySelector<HTMLButtonElement>('[data-limpiar]')!;
  const normalizar = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  interface Item { el: HTMLElement; seccion: HTMLElement; categoria: string; texto: string }
  // Índice de búsqueda precalculado (texto normalizado por producto).
  let productos: Item[] = [];
  const indexar = () => {
    productos = secciones.flatMap((s) =>
      [...s.querySelectorAll<HTMLElement>('.producto')].map((el) => ({ el, seccion: s, categoria: s.dataset.seccion!, texto: normalizar(el.dataset.texto ?? '') })),
    );
  };
  indexar();

  const contadorDe = (name: string, value: string) =>
    form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`)?.closest('.toggle')?.querySelector('.toggle__contador');
  const nombreCategoria = (id: string) => form.querySelector<HTMLInputElement>(`input[name="categoria"][value="${CSS.escape(id)}"]`)?.closest('.toggle')?.querySelector('span')?.textContent ?? '';

  const filtrar = () => {
    const datos = new FormData(form);
    const terminos = normalizar(String(datos.get('q') ?? '')).split(/\s+/).filter(Boolean);
    const categoria = String(datos.get('categoria') ?? '');
    const stock = String(datos.get('stock') ?? '');
    const porCategoria = new Map<string, number>();
    const porStock = new Map<string, number>();
    let total = 0;
    for (const p of productos) {
      const estado = p.el.dataset.estado ?? '';
      const coincideTexto = !p.el.hasAttribute('data-retirado') && terminos.every((t) => p.texto.includes(t));
      const enCategoria = !categoria || p.categoria === categoria;
      const enStock = !stock || estado === stock;
      // Contadores: cada grupo de filtros cuenta respetando los demás filtros activos.
      if (coincideTexto && enStock) porCategoria.set(p.categoria, (porCategoria.get(p.categoria) ?? 0) + 1);
      if (coincideTexto && enCategoria) porStock.set(estado, (porStock.get(estado) ?? 0) + 1);
      const ok = coincideTexto && enCategoria && enStock;
      p.el.hidden = !ok;
      if (ok) total++;
    }
    let conResultados = 0;
    for (const s of secciones) {
      const n = productos.filter((p) => p.seccion === s && !p.el.hidden).length;
      s.hidden = n === 0;
      const c = s.querySelector('[data-contador]');
      if (c) c.textContent = String(n);
      if (n) conResultados++;
    }
    const totalTexto = [...porCategoria.values()].reduce((a, b) => a + b, 0);
    const c0 = contadorDe('categoria', '');
    if (c0) c0.textContent = String(totalTexto);
    for (const s of secciones) {
      const c = contadorDe('categoria', s.dataset.seccion!);
      if (c) c.textContent = String(porCategoria.get(s.dataset.seccion!) ?? 0);
    }
    const totalStock = [...porStock.values()].reduce((a, b) => a + b, 0);
    for (const [valor, n] of [['', totalStock], ['con-stock', porStock.get('con-stock') ?? 0], ['sin-stock', porStock.get('sin-stock') ?? 0]] as const) {
      const c = contadorDe('stock', valor);
      if (c) c.textContent = String(n);
    }

    const hayBusqueda = terminos.length > 0;
    // "No encontramos productos" solo cuando el usuario escribió una búsqueda sin coincidencias.
    vacio.hidden = !(total === 0 && hayBusqueda);
    vacioFiltro.hidden = !(total === 0 && !hayBusqueda);
    if (total === 0 && !hayBusqueda) {
      const partes = [stock ? ETIQUETA[stock as Estado].toLowerCase() : '', categoria ? `en ${nombreCategoria(categoria)}` : ''].filter(Boolean);
      vacioFiltroTexto.textContent = `No hay productos ${partes.join(' ')} en este momento.`;
    }
    limpiar.hidden = !hayBusqueda && !categoria && !stock;
    resultado.textContent =
      total === 0
        ? 'Sin resultados.'
        : `${total} ${total === 1 ? 'producto' : 'productos'}${stock ? ` ${ETIQUETA[stock as Estado].toLowerCase()}` : ''}${conResultados > 1 ? ` en ${conResultados} categorías` : ''}${hayBusqueda ? ' para tu búsqueda' : ''}.`;

    // Los filtros quedan en la URL para compartir o volver (p. ej. /hipermercado/bazar/?categoria=celulares).
    const url = new URL(location.href);
    for (const [k, v] of [['q', terminos.length ? String(datos.get('q')) : ''], ['categoria', categoria], ['stock', stock]]) {
      if (v) url.searchParams.set(k, v); else url.searchParams.delete(k);
    }
    history.replaceState(null, '', url);
  };

  // Estado inicial desde la URL (enlaces de la portada a una categoría).
  const params = new URLSearchParams(location.search);
  const marcar = (name: string, value: string | null) => {
    const input = value != null && form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${CSS.escape(value)}"]`);
    if (input) input.checked = true;
  };
  marcar('categoria', params.get('categoria'));
  marcar('stock', params.get('stock'));
  if (params.get('q')) form.querySelector<HTMLInputElement>('input[name="q"]')!.value = params.get('q')!.slice(0, 80);

  let espera: number | undefined;
  form.addEventListener('input', (e) => {
    clearTimeout(espera);
    espera = window.setTimeout(filtrar, (e.target as HTMLElement).matches('input[type="search"]') ? 120 : 0);
  });
  form.addEventListener('change', filtrar);
  const reiniciar = () => {
    form.reset();
    filtrar();
  };
  limpiar.addEventListener('click', () => {
    reiniciar();
    form.querySelector<HTMLInputElement>('input[type="search"]')?.focus();
  });
  document.querySelector('[data-ver-todos]')!.addEventListener('click', reiniciar);
  filtrar();

  // ── Ficha de producto (colores con código, stock y consulta + descripción) ──
  const ficha = document.querySelector<HTMLDialogElement>('[data-ficha]')!;
  const fichaDesc = ficha.querySelector<HTMLElement>('[data-ficha-descripcion]')!;
  const descripciones = new Map<string, Promise<string | null>>();
  const pedirDescripcion = (id: string) => {
    if (!descripciones.has(id)) {
      descripciones.set(id, fetch(`/api/bazar/descripcion/${encodeURIComponent(id)}`, { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
        .then((d: { descripcion: string | null }) => d.descripcion)
        .catch((e) => { descripciones.delete(id); throw e; }));
    }
    return descripciones.get(id)!;
  };
  const mostrarDescripcion = (texto: string | null) => {
    fichaDesc.replaceChildren();
    if (!texto) {
      const p = document.createElement('p');
      p.textContent = 'Este producto no tiene descripción en el catálogo. Consultanos por WhatsApp y te pasamos los detalles.';
      fichaDesc.append(p);
      return;
    }
    // Cada renglón del catálogo es una característica: se muestran como lista (texto plano, sin HTML).
    const ul = document.createElement('ul');
    for (const l of texto.split(/\n+/).map((x) => x.trim()).filter(Boolean)) {
      const li = document.createElement('li');
      li.textContent = l;
      ul.append(li);
    }
    fichaDesc.append(ul);
  };
  // Lista de colores de la ficha, armada con los datos compactos de la tarjeta (data-ids + data-v; ver
  // TarjetaModelo.astro): cada color con su código, su stock, "Agregar" al carrito y su consulta por WhatsApp.
  type Variante = { id: string; codigo: string; color: string; estado: string };
  const variantesDe = (tarjeta: HTMLElement): Variante[] => {
    const ids = (tarjeta.dataset.ids ?? '').split(' ');
    const datos = JSON.parse(tarjeta.dataset.v ?? '[]') as [string, string, string][];
    return datos.map(([codigo, color, estado], k) => ({ id: ids[k], codigo, color, estado }));
  };
  const WHATSAPP = document.querySelector<HTMLElement>('[data-carrito]')!.dataset.wa;
  // Mismo mensaje que consultaProducto() de src/lib/inventario.ts.
  const consultaDe = (modelo: string, v: Variante) =>
    `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(`Hola! Quiero consultar por el producto: ${v.color ? `${modelo}, color ${v.color.toLowerCase()}` : modelo}${v.codigo ? ` (código interno COPOL ${v.codigo})` : ''}`)}`;
  const ICONO_STOCK: Record<string, string> = { 'con-stock': 'check', 'sin-stock': 'cerrar', 'sin-dato': 'info' };
  // Trazos de Icono.astro que usa la ficha.
  const TRAZOS: Record<string, string> = {
    check: '<path d="m5 12 4.5 4.5L19 7"/>',
    cerrar: '<path d="M18 6 6 18M6 6l12 12"/>',
    info: '<circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>',
    carrito: '<circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/>',
    whatsapp: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.6A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a3.5 3.5 0 0 1-1.8-1.8l.8-1-1-2z"/>',
  };
  const icono = (nombre: string, tamano: number) =>
    `<svg width="${tamano}" height="${tamano}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">${TRAZOS[nombre]}</svg>`;
  const span = (clase: string, texto: string) => Object.assign(document.createElement('span'), { className: clase, textContent: texto });
  const construirLista = (tarjeta: HTMLElement) => {
    const modelo = tarjeta.querySelector('[data-nombre]')?.textContent ?? '';
    const variantes = variantesDe(tarjeta);
    const ul = document.createElement('ul');
    ul.className = 'variantes';
    for (const v of variantes) {
      const li = document.createElement('li');
      li.className = 'variante';
      Object.assign(li.dataset, { id: v.id, estado: v.estado, codigo: v.codigo, color: v.color, modelo, categoriaNombre: tarjeta.dataset.categoriaNombre ?? '' });
      const deColor = v.color ? `, color ${v.color.toLowerCase()}` : '';
      li.append(span('variante__color', v.color || (variantes.length > 1 ? 'Color no indicado' : 'Modelo único')));
      if (v.codigo) li.append(span('variante__codigo', `Código interno COPOL ${v.codigo}`));
      const stock = span('variante__stock', ETIQUETA[v.estado as Estado] ?? '');
      stock.insertAdjacentHTML('afterbegin', icono(ICONO_STOCK[v.estado] ?? 'info', 14));
      const acciones = document.createElement('div');
      acciones.className = 'variante__acciones';
      const agregar = document.createElement('button');
      agregar.type = 'button';
      agregar.className = 'btn btn--default btn--sm variante__agregar';
      agregar.dataset.agregar = '';
      agregar.innerHTML = icono('carrito', 16);
      const textoAgregar = span('', 'Agregar');
      textoAgregar.dataset.agregarTexto = '';
      agregar.append(textoAgregar, span('visualmente-oculto', ` al carrito: ${modelo}${deColor}`));
      const consulta = Object.assign(document.createElement('a'), { href: consultaDe(modelo, v), className: 'btn btn--outline btn--sm variante__consulta', rel: 'noopener' });
      consulta.innerHTML = icono('whatsapp', 16);
      const textoConsulta = span('', 'Consultar');
      textoConsulta.append(span('visualmente-oculto', `: ${modelo}${deColor}`));
      consulta.append(textoConsulta);
      acciones.append(agregar, consulta);
      li.append(stock, acciones);
      ul.append(li);
    }
    return ul;
  };
  let tarjetaAbierta: HTMLElement | null = null;
  const abrirFicha = async (tarjeta: HTMLElement) => {
    tarjetaAbierta = tarjeta;
    const img = tarjeta.querySelector<HTMLImageElement>('.producto__media img');
    const cajaImg = ficha.querySelector<HTMLElement>('[data-ficha-imagen]')!;
    cajaImg.replaceChildren();
    if (img) {
      const copia = img.cloneNode() as HTMLImageElement;
      copia.loading = 'eager';
      copia.sizes = '200px';
      cajaImg.append(copia);
    }
    ficha.dataset.estado = tarjeta.dataset.estado ?? '';
    ficha.querySelector('[data-ficha-categoria]')!.textContent = tarjeta.querySelector('.producto__categoria')?.textContent ?? '';
    ficha.querySelector('[data-ficha-titulo]')!.textContent = tarjeta.querySelector('[data-nombre]')?.textContent ?? '';
    ficha.querySelector('[data-ficha-resumen]')!.textContent = tarjeta.querySelector('.producto__codigo')?.textContent ?? '';
    const n = Number(tarjeta.dataset.variantes ?? 1);
    ficha.querySelector('[data-ficha-var-titulo]')!.textContent = n > 1 ? `Colores (${n}) y stock` : 'Código y stock';
    ficha.querySelector('[data-ficha-variantes]')!.replaceChildren(construirLista(tarjeta));
    marcarAgregados();
    if (!ficha.open) ficha.showModal();
    ficha.querySelector<HTMLElement>('.ficha__caja')!.scrollTop = 0;
    const id = tarjeta.dataset.descripcion;
    if (!id) return mostrarDescripcion(null);
    fichaDesc.textContent = 'Cargando descripción…';
    try {
      const texto = await pedirDescripcion(id);
      if (tarjetaAbierta === tarjeta) mostrarDescripcion(texto);
    } catch {
      if (tarjetaAbierta === tarjeta) fichaDesc.textContent = 'No pudimos cargar la descripción. Consultanos por WhatsApp.';
    }
  };
  document.querySelector('[data-secciones]')!.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const tarjeta = objetivo.closest<HTMLElement>('.producto--modelo');
    if (!tarjeta) return;
    // "Ver detalle" es el <summary> de un <details>: con JS abre la ficha en vez de desplegar la lista.
    if (objetivo.closest('[data-abrir]') || objetivo.closest('[data-abrir-imagen]')) {
      e.preventDefault();
      abrirFicha(tarjeta);
    }
  });
  ficha.querySelector('[data-ficha-cerrar]')!.addEventListener('click', () => ficha.close());
  // Clic en el fondo oscuro: cierra.
  ficha.addEventListener('click', (e) => { if (e.target === ficha) ficha.close(); });
  ficha.addEventListener('close', () => {
    tarjetaAbierta?.querySelector<HTMLElement>('[data-abrir]')?.focus();
    tarjetaAbierta = null;
  });

  // ── Carrito COPOL ──
  // Se guarda en este navegador (localStorage). Cada ítem es un producto (un color) identificado por su
  // código interno COPOL; al enviar se arma un mensaje de WhatsApp ordenado por categoría.
  interface ItemCarrito { id: string; codigo: string; modelo: string; color: string; categoria: string; estado: string; cantidad: number }
  const CLAVE_CARRITO = 'copol-carrito';
  const MAX_ITEMS_CARRITO = 40;
  const MAX_UNIDADES = 20;
  const carritoDialogo = document.querySelector<HTMLDialogElement>('[data-carrito]')!;
  const carritoBoton = document.querySelector<HTMLButtonElement>('[data-carrito-abrir]')!;
  const carritoCuenta = document.querySelector<HTMLElement>('[data-carrito-cuenta]')!;
  const carritoAviso = document.querySelector<HTMLElement>('[data-carrito-aviso]')!;
  const carritoLista = carritoDialogo.querySelector<HTMLElement>('[data-carrito-lista]')!;
  const carritoEnviar = carritoDialogo.querySelector<HTMLAnchorElement>('[data-carrito-enviar]')!;
  let carrito: ItemCarrito[] = [];
  try {
    const guardado = JSON.parse(localStorage.getItem(CLAVE_CARRITO) ?? '[]');
    if (Array.isArray(guardado)) carrito = guardado.filter((x) => x && typeof x.id === 'string' && typeof x.modelo === 'string').slice(0, MAX_ITEMS_CARRITO);
  } catch { /* sin almacenamiento: el carrito vive mientras la página esté abierta */ }

  // El stock mostrado en el carrito se actualiza con el de esta carga de la página.
  const estados = new Map(productos.flatMap((p) => variantesDe(p.el).map((v) => [v.id, v.estado] as const)));
  carrito.forEach((i) => { i.estado = estados.get(i.id) ?? i.estado; });

  const unidades = () => carrito.reduce((a, i) => a + i.cantidad, 0);
  const guardarCarrito = () => {
    try { localStorage.setItem(CLAVE_CARRITO, JSON.stringify(carrito)); } catch { /* sin almacenamiento */ }
  };
  const nombreItem = (i: ItemCarrito) => `${i.modelo}${i.color ? ` (${i.color.toLowerCase()})` : ''}`;
  const mensajeWhatsapp = () => {
    const porCategoria = new Map<string, ItemCarrito[]>();
    for (const i of carrito) (porCategoria.get(i.categoria) ?? porCategoria.set(i.categoria, []).get(i.categoria)!).push(i);
    const categorias = [...porCategoria.keys()].sort((a, b) => a.localeCompare(b, 'es'));
    let n = 0;
    const lineas = ['Hola! Quiero consultar por estos productos del Bazar COPOL:', ''];
    for (const c of categorias) {
      lineas.push(`*${c}*`);
      for (const i of porCategoria.get(c)!.sort((a, b) => nombreItem(a).localeCompare(nombreItem(b), 'es'))) {
        n++;
        lineas.push(`${n}. ${i.modelo}${i.color ? ` — Color: ${i.color}` : ''} — Código interno COPOL: ${i.codigo || 's/c'} — Cantidad: ${i.cantidad}`);
      }
      lineas.push('');
    }
    lineas.push(`Total: ${carrito.length} ${carrito.length === 1 ? 'producto' : 'productos'} (${unidades()} ${unidades() === 1 ? 'unidad' : 'unidades'}).`);
    lineas.push('¿Me confirman disponibilidad y condiciones de pago? ¡Gracias!');
    return lineas.join('\n');
  };

  const botonCantidad = (etiqueta: string, icono: 'mas' | 'menos', accion: () => void, deshabilitado = false) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'carrito__cantidad-boton';
    b.setAttribute('aria-label', etiqueta);
    b.disabled = deshabilitado;
    b.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">${icono === 'mas' ? '<path d="M12 5v14M5 12h14"/>' : '<path d="M5 12h14"/>'}</svg>`;
    b.addEventListener('click', accion);
    return b;
  };
  const ETIQUETA_STOCK: Record<string, string> = { 'con-stock': 'Con stock', 'sin-stock': 'Sin stock', 'sin-dato': 'Consultar disponibilidad' };
  const pintarCarrito = () => {
    const total = unidades();
    carritoCuenta.textContent = String(total);
    carritoBoton.hidden = carrito.length === 0;
    carritoBoton.setAttribute('aria-label', `Mi carrito: ${total} ${total === 1 ? 'unidad' : 'unidades'}`);
    carritoDialogo.querySelector('[data-carrito-vacio]')!.toggleAttribute('hidden', carrito.length > 0);
    carritoDialogo.querySelector('[data-carrito-pie]')!.toggleAttribute('hidden', carrito.length === 0);
    carritoDialogo.querySelector('[data-carrito-resumen]')!.textContent = carrito.length ? `${carrito.length} ${carrito.length === 1 ? 'producto' : 'productos'} · ${total} ${total === 1 ? 'unidad' : 'unidades'}` : '';
    carritoLista.replaceChildren(...carrito.map((i) => {
      const li = document.createElement('li');
      li.className = 'carrito__item';
      li.dataset.estado = i.estado;
      const info = document.createElement('div');
      info.className = 'carrito__info';
      const nombre = document.createElement('strong');
      nombre.textContent = i.modelo;
      const detalle = document.createElement('span');
      detalle.className = 'carrito__detalle';
      detalle.textContent = [i.color && `Color: ${i.color}`, i.codigo && `Código interno COPOL ${i.codigo}`].filter(Boolean).join(' · ');
      const stock = document.createElement('span');
      stock.className = 'carrito__stock';
      stock.textContent = ETIQUETA_STOCK[i.estado] ?? '';
      info.append(nombre, detalle, stock);
      const controles = document.createElement('div');
      controles.className = 'carrito__controles';
      const cant = document.createElement('span');
      cant.className = 'carrito__cantidad';
      cant.textContent = String(i.cantidad);
      cant.setAttribute('aria-label', `Cantidad: ${i.cantidad}`);
      const quitar = document.createElement('button');
      quitar.type = 'button';
      quitar.className = 'btn btn--ghost btn--sm carrito__quitar';
      quitar.textContent = 'Quitar';
      quitar.setAttribute('aria-label', `Quitar ${nombreItem(i)} del carrito`);
      quitar.addEventListener('click', () => { carrito = carrito.filter((x) => x.id !== i.id); cambio(); });
      controles.append(
        botonCantidad(`Una unidad menos de ${nombreItem(i)}`, 'menos', () => { i.cantidad = Math.max(1, i.cantidad - 1); cambio(); }, i.cantidad <= 1),
        cant,
        botonCantidad(`Una unidad más de ${nombreItem(i)}`, 'mas', () => { i.cantidad = Math.min(MAX_UNIDADES, i.cantidad + 1); cambio(); }, i.cantidad >= MAX_UNIDADES),
        quitar,
      );
      li.append(info, controles);
      return li;
    }));
    carritoEnviar.href = `https://wa.me/${carritoDialogo.dataset.wa}?text=${encodeURIComponent(mensajeWhatsapp())}`;
    marcarAgregados();
  };
  // Marca los botones "Agregar" de la ficha abierta con lo que ya está en el carrito.
  function marcarAgregados() {
    ficha.querySelectorAll<HTMLButtonElement>('[data-agregar]').forEach((b) => {
      const id = b.closest<HTMLElement>('.variante')?.dataset.id ?? '';
      const item = carrito.find((x) => x.id === id);
      b.toggleAttribute('data-en-carrito', Boolean(item));
      const t = b.querySelector('[data-agregar-texto]');
      if (t) t.textContent = item ? `En el carrito (${item.cantidad})` : 'Agregar';
    });
  }
  const cambio = () => { guardarCarrito(); pintarCarrito(); };

  let ocultarAviso: number | undefined;
  const avisar = (texto: string) => {
    // Con una ventana abierta (ficha o carrito) el aviso va dentro de ella para verse por encima del fondo.
    const contenedor = [ficha, carritoDialogo].find((d) => d.open) ?? document.body;
    if (carritoAviso.parentElement !== contenedor) contenedor.append(carritoAviso);
    carritoAviso.textContent = texto;
    carritoAviso.classList.add('carrito-aviso--visible');
    clearTimeout(ocultarAviso);
    ocultarAviso = window.setTimeout(() => carritoAviso.classList.remove('carrito-aviso--visible'), 2600);
  };
  const agregar = (fila: HTMLElement) => {
    const id = fila.dataset.id ?? '';
    const existente = carrito.find((x) => x.id === id);
    if (existente) {
      existente.cantidad = Math.min(MAX_UNIDADES, existente.cantidad + 1);
    } else {
      if (carrito.length >= MAX_ITEMS_CARRITO) return avisar(`El carrito admite hasta ${MAX_ITEMS_CARRITO} productos distintos.`);
      carrito.push({ id, codigo: fila.dataset.codigo ?? '', modelo: fila.dataset.modelo ?? '', color: fila.dataset.color ?? '', categoria: fila.dataset.categoriaNombre ?? 'Bazar', estado: fila.dataset.estado ?? 'sin-dato', cantidad: 1 });
    }
    cambio();
    const item = carrito.find((x) => x.id === id)!;
    avisar(`Agregado al carrito: ${nombreItem(item)} · ${item.cantidad} ${item.cantidad === 1 ? 'unidad' : 'unidades'}`);
  };

  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    const fila = b?.closest<HTMLElement>('.variante');
    if (b && fila) { e.preventDefault(); agregar(fila); }
  });
  carritoBoton.addEventListener('click', () => {
    if (ficha.open) ficha.close();
    carritoAviso.classList.remove('carrito-aviso--visible');
    pintarCarrito();
    carritoDialogo.showModal();
  });
  carritoDialogo.querySelector('[data-carrito-cerrar]')!.addEventListener('click', () => carritoDialogo.close());
  carritoDialogo.addEventListener('click', (e) => { if (e.target === carritoDialogo) carritoDialogo.close(); });
  carritoDialogo.addEventListener('close', () => { if (!carritoBoton.hidden) carritoBoton.focus(); });
  carritoDialogo.querySelector('[data-carrito-vaciar]')!.addEventListener('click', () => {
    if (!confirm('¿Vaciar el carrito?')) return;
    carrito = [];
    cambio();
  });
  // Otra pestaña cambió el carrito: se sincroniza.
  window.addEventListener('storage', (e) => {
    if (e.key !== CLAVE_CARRITO) return;
    try { carrito = JSON.parse(e.newValue ?? '[]'); } catch { carrito = []; }
    pintarCarrito();
  });
  pintarCarrito();

  // ── Barra de filtros compacta al bajar ──
  // Escritorio: se compacta al bajar y vuelve a su tamaño al subir. Móvil: queda compacta mientras se
  // recorre la lista (completa ocuparía casi media pantalla) y vuelve al llegar arriba.
  const angosta = window.matchMedia('(max-width: 899px)');
  let umbral = form.getBoundingClientRect().top + window.scrollY + 40;
  let ultimoY = window.scrollY;
  let pendiente = false;
  let quietoHasta = 0;
  const compactar = (si: boolean) => {
    if (form.classList.contains('barra--compacta') === si) return;
    form.classList.toggle('barra--compacta', si);
    // Al cambiar de alto, el navegador corrige el scroll para no mover el contenido (scroll anchoring):
    // ese salto no es un gesto del usuario y se ignora mientras dura la transición.
    quietoHasta = performance.now() + 400;
    window.setTimeout(() => { ultimoY = window.scrollY; }, 420);
  };
  window.addEventListener('scroll', () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      if (performance.now() < quietoHasta) return;
      const y = window.scrollY;
      const dy = y - ultimoY;
      if (y < umbral) compactar(false);
      else if (angosta.matches || dy > 6) compactar(true);
      else if (dy < -6 && !form.contains(document.activeElement)) compactar(false);
      if (Math.abs(dy) > 6 || y < umbral) ultimoY = y;
    });
  }, { passive: true });
  window.addEventListener('resize', () => { if (!form.classList.contains('barra--compacta')) umbral = form.getBoundingClientRect().top + window.scrollY + 40; });

</script>

<style>
  .catalogo { padding-top: clamp(28px, 4vw, 48px); padding-bottom: var(--seccion); }
  .barra {
    position: sticky; top: 76px; z-index: 20;
    display: grid;
    gap: 14px;
    padding: 16px;
    margin-inline: -16px;
    border-radius: 0 0 var(--radio-lg) var(--radio-lg);
    background: color-mix(in srgb, var(--fondo-pagina) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    box-shadow: 0 1px 0 var(--border);
    transition: padding 280ms var(--ease-out-quart), gap 280ms var(--ease-out-quart), box-shadow 280ms var(--ease-out-quart);
  }
  /* Compacta al bajar: sin etiquetas, controles más bajos y categorías en una fila deslizable. */
  .barra--compacta { padding-block: 8px; gap: 8px; box-shadow: 0 1px 0 var(--border), 0 10px 22px -16px rgb(0 51 26 / 0.45); }
  .barra.barra--compacta legend,
  .barra.barra--compacta :global(.barra__busqueda .label) { position: absolute; left: 0; top: 0; width: 1px !important; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; float: none; margin: 0; }
  .barra--compacta :global(.barra__busqueda .input) { min-height: 40px; padding-block: 6px; }
  .barra--compacta :global(.toggle) { min-height: 34px; padding-block: 4px; font-size: 0.875rem; }
  .barra--compacta .barra__fila { align-items: center; }
  .barra { grid-template-columns: minmax(0, 1fr); }
  .barra__categorias { min-width: 0; min-inline-size: 0; }
  .barra--compacta .barra__categorias {
    flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: -16px; padding-inline: 16px;
    mask-image: linear-gradient(to right, transparent, #000 16px, #000 calc(100% - 24px), transparent);
  }
  .barra--compacta .barra__categorias::-webkit-scrollbar { display: none; }
  .barra--compacta .barra__categorias :global(.toggle) { flex: none; }
  .barra :global(.label),
  .barra :global(.toggle),
  .barra :global(.input) { transition: min-height 280ms var(--ease-out-quart), padding 280ms var(--ease-out-quart); }
  @media (prefers-reduced-motion: reduce) {
    .barra, .barra :global(.label), .barra :global(.toggle), .barra :global(.input) { transition: none; }
  }
  .barra__fila { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: flex-end; }
  .barra :global(.barra__busqueda) { flex: 1 1 320px; max-width: 560px; }
  .barra__stock { flex: none; }
  .barra__stock legend, .barra__categorias legend { margin-bottom: 10px; padding: 0; float: left; width: 100%; }
  .punto { width: 9px; height: 9px; border-radius: 50%; display: inline-block; margin-right: 6px; vertical-align: 1px; box-shadow: 0 0 0 2px #fff; }
  .punto--con { background: #0f7a3a; }
  .punto--sin { background: #8a938f; }
  @media (max-width: 899px) {
    /* En móvil y tablet las categorías se desplazan en horizontal. */
    .barra__categorias {
      flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity;
      margin-inline: -16px; padding: 2px 16px 8px; scrollbar-width: thin;
    }
    .barra__categorias legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .barra__categorias :global(.toggle) { flex: none; scroll-snap-align: start; }
  }
  .barra__fila > * { min-width: 0; }
  @media (max-width: 559px) {
    /* Tres opciones del mismo ancho; el total de cada una se anuncia en el texto de resultados. */
    .barra__fila { display: grid; grid-template-columns: minmax(0, 1fr); }
    .barra__stock { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .barra__stock legend { grid-column: 1 / -1; margin-bottom: 2px; }
    .barra__stock :global(.toggle) { min-width: 0; justify-content: center; padding-inline: 6px; font-size: 0.875rem; white-space: nowrap; }
    .barra__stock :global(.toggle__contador) { display: none; }
    .barra--compacta .barra__stock :global(.toggle) { min-height: 32px; }
  }

  .estado { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; margin: 20px 0 8px; }
  .estado__texto { color: var(--muted-foreground); font-weight: 600; }

  .secciones { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(40px, 5vw, 64px); margin-top: 16px; }
  /* Más de 800 tarjetas: el navegador omite el render de las categorías fuera de pantalla.
     Solo se estima la altura (el ancho lo define la grilla). */
  .seccion-cat { display: grid; gap: 20px; scroll-margin-top: 220px; content-visibility: auto; contain-intrinsic-block-size: auto 1200px; }
  .seccion-cat__cabecera { display: flex; align-items: center; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--border); }
  .seccion-cat__cabecera h3 { font-size: clamp(1.375rem, 2.4vw, 1.75rem); letter-spacing: -0.02em; }

  .aviso-stock { display: flex; gap: 10px; align-items: flex-start; margin-top: 16px; padding: 12px 16px; border-radius: var(--radio-md); background: #fdf5d8; color: #6b4a00; font-weight: 600; }
  .aviso-stock :global(svg) { flex: none; margin-top: 2px; }
  .vacio { align-items: center; text-align: center; padding: 40px 24px; margin-top: 16px; }
  .vacio__titulo { font-weight: 700; font-size: 1.125rem; color: var(--foreground) !important; }
  .aviso-legal { margin-top: 48px; padding: 20px 24px; border-radius: var(--radio-lg); background: var(--card); box-shadow: var(--anillo); font-size: 0.875rem; color: var(--muted-foreground); display: grid; gap: 8px; }
</style>

<style is:global>
  /* Ficha de producto (dialog nativo: foco atrapado, Esc cierra, fondo inerte) */
  .ficha {
    width: min(100% - 32px, 640px); max-height: min(100dvh - 48px, 860px); padding: 0; border: 0;
    border-radius: var(--radio-xl); background: var(--card); color: var(--foreground); box-shadow: var(--sombra);
  }
  .ficha::backdrop { background: rgb(0 30 15 / 0.55); }
  .ficha__caja { --pad: clamp(20px, 3vw, 28px); position: relative; display: grid; gap: 22px; padding: 0 var(--pad) var(--pad); max-height: inherit; overflow-y: auto; overscroll-behavior: contain; }
  /* Barra con el botón de cerrar: queda fija arriba y el contenido pasa por debajo (no tapa botones). */
  .ficha__barra {
    position: sticky; top: 0; z-index: 2; display: flex; justify-content: flex-end;
    margin: 0 calc(-1 * var(--pad)) -26px; padding: 12px 12px 4px;
    background: linear-gradient(var(--card) 75%, rgb(255 255 255 / 0));
  }
  .ficha__cerrar {
    display: inline-grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: var(--radio-pill);
    background: var(--card); color: var(--verde-oscuro); box-shadow: var(--anillo-fuerte); cursor: pointer;
  }
  .ficha__cerrar:hover { background: var(--muted); }
  .ficha__cabecera { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: 18px; align-items: center; }
  .ficha__imagen { aspect-ratio: 1; border-radius: var(--radio-lg); background: #fff; box-shadow: var(--anillo); display: grid; place-items: center; overflow: hidden; }
  .ficha__imagen img { width: 100%; height: 100%; object-fit: contain; padding: 10px; mix-blend-mode: multiply; }
  .ficha[data-estado='sin-stock'] .ficha__imagen img { filter: grayscale(1); opacity: 0.7; }
  .ficha__titulos { display: grid; gap: 6px; }
  .ficha__titulo { font-size: clamp(1.25rem, 2.6vw, 1.5rem); line-height: 1.2; }
  .ficha__resumen { color: var(--muted-foreground); font-size: 0.9375rem; }
  .ficha__seccion { display: grid; gap: 10px; }
  .ficha__subtitulo { font-size: 1rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--verde-oscuro); }
  .ficha__descripcion { font-size: 0.9375rem; line-height: 1.55; color: var(--foreground); }
  .ficha__descripcion ul { margin: 0; padding-left: 20px; display: grid; gap: 4px; }
  .ficha__nota { font-size: 0.8125rem; color: var(--muted-foreground); }
  @media (max-width: 559px) {
    .ficha { width: 100%; max-width: 100%; max-height: 92dvh; margin: auto 0 0; border-radius: var(--radio-xl) var(--radio-xl) 0 0; }
    .ficha__cabecera { grid-template-columns: 88px minmax(0, 1fr); gap: 14px; }
  }
  @media (prefers-reduced-motion: no-preference) {
