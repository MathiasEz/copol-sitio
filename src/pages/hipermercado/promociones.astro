---
import Base from '../../layouts/Base.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import Icono from '../../components/Icono.astro';
import { REDES } from '../../data/confirmado/sitio';
import Button from '../../components/ui/Button.astro';
import OfertasSupermercado from '../../components/OfertasSupermercado.astro';

// Ofertas del supermercado (se cargan en el panel). Las campañas de motos y de garantía de alquiler se retiraron.
---
<Base titulo="Promociones" descripcion="Ofertas del supermercado COPOL.">
  <EncabezadoPagina
    titulo="Promociones"
    antetitulo="Hipermercado · Ofertas activas"
    bajada="Ofertas de la Cooperativa Policial para todos."
    migas={[{ texto: 'Hipermercado', href: '/hipermercado/' }, { texto: 'Promociones' }]}
  >
    <Button href={REDES.instagram} variant="outline"><Icono nombre="instagram" tamano={18} /> Novedades en Instagram</Button>
  </EncabezadoPagina>

  <!-- Ofertas del supermercado: se cargan cada mes en el panel (Administración Página → Ofertas) -->
  <OfertasSupermercado server:defer>
    <div slot="fallback" class="contenedor seccion" aria-hidden="true"><div class="ofertas-esqueleto"></div></div>
  </OfertasSupermercado>

</Base>

<style>
  .ofertas-esqueleto { height: clamp(420px, 34vw, 520px); border-radius: var(--radio-xl); background: var(--muted); }
</style>
