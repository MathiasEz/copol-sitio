---
import Base from '../../layouts/Base.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import BandaSocio from '../../components/BandaSocio.astro';
import Icono from '../../components/Icono.astro';
import { CONVENIOS, telHref } from '../../lib/datos';
import { CONTACTO, whatsapp } from '../../data/confirmado/sitio';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Campo from '../../components/ui/Campo.astro';

const departamentos = [...new Set(CONVENIOS.map((c) => c.departamento))].sort((a, b) => a.localeCompare(b, 'es'));
const rubros = Object.entries(
  CONVENIOS.reduce<Record<string, number>>((acc, c) => ((acc[c.rubro] = (acc[c.rubro] ?? 0) + 1), acc), {}),
).sort((a, b) => b[1] - a[1]);
const normalizar = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
---
<Base titulo="Convenios" descripcion={`Convenios de COPOL: ${CONVENIOS.length} comercios adheridos en ${departamentos.length} departamentos. Buscá por departamento, rubro o nombre.`}>
  <EncabezadoPagina
    titulo="Convenios en todo el país"
    antetitulo="Beneficios"
    bajada={`${CONVENIOS.length} comercios, servicios y profesionales adheridos en ${departamentos.length} departamentos, para que disfrutes beneficios exclusivos como socio.`}
    migas={[{ texto: 'Beneficios', href: '/beneficios/' }, { texto: 'Convenios' }]}
  />

  <section class="contenedor" aria-labelledby="nuevo-convenio">
    <div class="card nuevo aparecer">
      <Badge variant="accent">Nuevo convenio</Badge>
      <div>
        <h2 id="nuevo-convenio">Porto Seguro: garantía de alquiler</h2>
        <p>Garantía de alquiler en todo el país, hasta en 10 cuotas sin tarjeta.</p>
      </div>
      <Button href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola, quiero info sobre la garantía de alquiler con Porto Seguro')}><Icono nombre="whatsapp" tamano={18} /> Consultar</Button>
    </div>
  </section>

  <section class="contenedor seccion" aria-labelledby="buscador-titulo">
    <h2 id="buscador-titulo">Buscá un convenio</h2>
    <form class="buscador" data-buscador role="search" aria-label="Buscar convenios" onsubmit="return false">
      <Campo etiqueta="Nombre, rubro o localidad" name="q" type="search" icono="buscar" placeholder="Farmacia, óptica, Rivera…" autocomplete="off" />
      <Campo etiqueta="Departamento" name="departamento" control="select">
        <option value="">Todos</option>
        {departamentos.map((d) => <option value={d}>{d}</option>)}
      </Campo>
      <Campo etiqueta="Rubro" name="rubro" control="select">
        <option value="">Todos</option>
        {rubros.map(([r, n]) => <option value={r}>{r} ({n})</option>)}
      </Campo>
      <Button type="reset" variant="secondary" class="buscador__limpiar">Limpiar</Button>
    </form>
    <p class="resultado" aria-live="polite" data-resultado>Mostrando {CONVENIOS.length} de {CONVENIOS.length} convenios.</p>

    <ul class="convenios" data-convenios>
      {CONVENIOS.map((c) => (
        <li class="card convenio" data-departamento={c.departamento} data-rubro={c.rubro} data-texto={normalizar(`${c.nombre} ${c.rubro} ${c.localidad} ${c.departamento} ${c.direccion ?? ''}`)}>
          <span class="convenio__rubro">{c.rubro}</span>
          <h3>{c.nombre}</h3>
          <p class="convenio__lugar"><Icono nombre="ubicacion" tamano={16} /> {[c.direccion, c.localidad !== c.departamento ? c.localidad : null, c.departamento].filter(Boolean).join(', ')}</p>
          <div class="convenio__acciones">
            {c.telefono && <a href={telHref(c.telefono)} class="convenio__tel"><Icono nombre="telefono" tamano={16} /> {c.telefono}</a>}
            {c.lat && c.lng && (
              <a href={`https://www.google.com/maps/search/?api=1&query=${c.lat},${c.lng}`} rel="noopener" class="convenio__mapa">
                Ver en el mapa<span class="visualmente-oculto">: {c.nombre}</span>
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="card card--dashed vacio" data-vacio hidden><p>No encontramos convenios con esa búsqueda. Probá con otro término o escribinos y te ayudamos.</p></div>
    <p class="nota">¿Tenés un comercio y querés adherirte? <a href="/contacto/">Contactanos</a>.</p>
  </section>

  <BandaSocio />
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-buscador]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-convenios] > li')];
  const resultado = document.querySelector<HTMLElement>('[data-resultado]');
  const vacio = document.querySelector<HTMLElement>('[data-vacio]');
  const normalizar = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  const filtrar = () => {
    if (!form) return;
    const datos = new FormData(form);
    const q = normalizar(String(datos.get('q') ?? ''));
    const depto = String(datos.get('departamento') ?? '');
    const rubro = String(datos.get('rubro') ?? '');
    let n = 0;
    items.forEach((li) => {
      const ok = (!q || li.dataset.texto!.includes(q)) && (!depto || li.dataset.departamento === depto) && (!rubro || li.dataset.rubro === rubro);
      li.hidden = !ok;
      if (ok) n++;
    });
    if (resultado) resultado.textContent = `Mostrando ${n} de ${items.length} convenios.`;
    if (vacio) vacio.hidden = n > 0;
  };
  form?.addEventListener('input', filtrar);
  form?.addEventListener('change', filtrar);
  form?.addEventListener('reset', () => setTimeout(filtrar));
</script>

<style>
  .nuevo {
    flex-direction: row; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between;
    margin-top: clamp(32px, 4vw, 48px); padding: clamp(22px, 3vw, 32px); border-radius: var(--radio-xl);
    box-shadow: inset 0 0 0 2px var(--amarillo-copol);
  }
  .nuevo > div { flex: 1 1 360px; display: grid; gap: 6px; }
  .nuevo h2 { font-size: 1.5rem; }

  .buscador { display: grid; gap: 16px; margin-top: 20px; align-items: end; }
  @media (min-width: 900px) { .buscador { grid-template-columns: 2fr 1fr 1fr auto; } }
  .resultado { margin: 20px 0 16px; color: var(--muted-foreground); font-weight: 600; }

  .convenios { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .convenio { gap: 8px; padding: 18px; }
  .convenio__rubro { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--verde-oscuro); }
  .convenio h3 { font-size: 1.0625rem; color: var(--tinta); letter-spacing: 0; }
  .convenio__lugar { display: flex; gap: 6px; align-items: flex-start; font-size: 0.9rem; color: var(--tinta-suave); }
  .convenio__lugar :global(svg) { flex: none; margin-top: 3px; color: var(--verde-copol); }
  .convenio__acciones { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-top: auto; padding-top: 4px; font-size: 0.9375rem; font-weight: 600; }
  .convenio__acciones a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; }
  .vacio { text-align: center; align-items: center; margin-top: 16px; }
  .nota { margin-top: 24px; color: var(--tinta-suave); }
</style>
