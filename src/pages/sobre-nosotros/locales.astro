---
import Base from '../../layouts/Base.astro';
import EncabezadoPagina from '../../components/EncabezadoPagina.astro';
import Icono from '../../components/Icono.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';
import Campo from '../../components/ui/Campo.astro';
import Toggle from '../../components/ui/Toggle.astro';
import Media from '../../components/ui/Media.astro';
import MapaPuntos from '../../components/MapaPuntos.astro';
import { LOCALES, TIPO_LOCAL, telHref, type TipoLocal } from '../../lib/datos';
import { fotoLocal } from '../../lib/imagenes';
import { CONTACTO, HORARIOS, whatsapp } from '../../data/confirmado/sitio';

const departamentos = [...new Set(LOCALES.map((l) => l.departamento))].sort((a, b) => a.localeCompare(b, 'es'));
const conteo = (t: TipoLocal) => LOCALES.filter((l) => l.tipo === t).length;
const varianteTipo = { 'casa-central': 'default', sucursal: 'accent', agencia: 'secondary' } as const;
// Dos bloques: Casa Central y las sucursales juntas (una fila en escritorio) y, debajo, las agencias.
const nombreLocal = (l: (typeof LOCALES)[number]) => (l.tipo === 'casa-central' ? 'Casa Central' : `${TIPO_LOCAL[l.tipo]} ${l.ciudad}`);
const PUNTOS = LOCALES.map((l) => ({
  id: l.id, lat: l.lat, lng: l.lng, titulo: nombreLocal(l), detalle: `${l.direccion}, ${l.ciudad}`,
  antetitulo: l.tipo === 'casa-central' ? 'Sede principal' : l.departamento !== l.ciudad ? l.departamento : undefined, destacado: l.tipo === 'casa-central',
}));
const GRUPOS = [
  { id: 'principales', titulo: 'Casa Central y sucursales', locales: LOCALES.filter((l) => l.tipo !== 'agencia') },
  { id: 'agencias', titulo: 'Agencias', locales: LOCALES.filter((l) => l.tipo === 'agencia') },
];
---
<Base titulo="Locales" descripcion={`Los ${LOCALES.length} locales de COPOL en todo el país: Casa Central, sucursales y agencias, con direcciones, teléfonos y cómo llegar.`}>
  <EncabezadoPagina
    titulo="Nuestros locales"
    antetitulo="Sobre nosotros"
    bajada={`Casa Central en Montevideo, ${conteo('sucursal')} sucursales y ${conteo('agencia')} agencias para atenderte en todo el país.`}
    migas={[{ texto: 'Sobre nosotros', href: '/sobre-nosotros/' }, { texto: 'Locales' }]}
  >
    <Button href={CONTACTO.telefono.href}><Icono nombre="telefono" tamano={18} /> {CONTACTO.telefono.texto}</Button>
    <Button href={whatsapp(CONTACTO.whatsappGeneral.numero)} variant="outline"><Icono nombre="whatsapp" tamano={18} /> {CONTACTO.whatsappGeneral.texto}</Button>
  </EncabezadoPagina>

  <section class="contenedor mapa-locales" aria-labelledby="mapa-titulo">
    <h2 id="mapa-titulo" class="visualmente-oculto">Mapa de locales</h2>
    <MapaPuntos puntos={PUNTOS} etiqueta={`Mapa con los ${LOCALES.length} locales de COPOL`} />
    <p class="mapa-locales__ayuda">Tocá una tarjeta para verla en el mapa.</p>
  </section>

  <section class="contenedor seccion seccion--tras-mapa" aria-labelledby="listado-titulo">
    <div class="encabezado-seccion">
      <div>
        <h2 id="listado-titulo"><span class="mascara"><span>Encontrá tu local</span></span></h2>
        <p class="lead">Filtrá por tipo de local o departamento.</p>
      </div>
    </div>

    <form class="filtros" data-filtros-locales aria-label="Filtrar locales" onsubmit="return false">
      <fieldset class="toggle-group">
        <legend class="visualmente-oculto">Tipo de local</legend>
        <Toggle name="tipo" value="" checked contador={LOCALES.length}>Todos</Toggle>
        {(['casa-central', 'sucursal', 'agencia'] as TipoLocal[]).map((t) => (
          <Toggle name="tipo" value={t} contador={conteo(t)}>{t === 'casa-central' ? 'Casa Central' : t === 'sucursal' ? 'Sucursales' : 'Agencias'}</Toggle>
        ))}
      </fieldset>
      <Campo etiqueta="Departamento" name="departamento" control="select" class="filtros__depto">
        <option value="">Todos los departamentos</option>
        {departamentos.map((d) => <option value={d}>{d}</option>)}
      </Campo>
    </form>
    <p class="resultado" aria-live="polite" data-resultado>Mostrando {LOCALES.length} locales.</p>

    {GRUPOS.map((g, gi) => (
    <section class="grupo" data-grupo aria-labelledby={`grupo-${g.id}`}>
    <h3 class="grupo__titulo" id={`grupo-${g.id}`}>{g.titulo} <span class="grupo__cuenta">{g.locales.length}</span></h3>
    <ul class:list={['locales', `locales--${g.id}`]} data-locales>
      {g.locales.map((l, i) => {
        const foto = fotoLocal(l.id);
        const nombre = l.tipo === 'casa-central' ? 'Casa Central' : `${TIPO_LOCAL[l.tipo]} ${l.ciudad}`;
        return (
        <li class:list={['card', 'local', `local--${l.tipo}`]} data-tipo={l.tipo} data-departamento={l.departamento} data-punto={l.id}>
          {foto && (
            <figure class="local__foto">
              <Media
                src={foto}
                alt={`Letras con el nombre de ${l.ciudad}, ciudad donde está ${l.tipo === 'casa-central' ? 'la Casa Central' : `la ${TIPO_LOCAL[l.tipo].toLowerCase()}`} de COPOL`}
                ratio="16/9"
                widths={[400, 640, 800]}
                sizes={g.id === 'principales' ? '(min-width: 1344px) 632px, (min-width: 760px) 50vw, 100vw' : '(min-width: 1100px) 410px, (min-width: 640px) 50vw, 100vw'}
                loading={gi === 0 ? 'eager' : 'lazy'}
                radio="var(--radio-md)"
              />
              {/* El nombre del local va justo debajo; sobre la foto solo se indica la localidad cuando difiere. */}
              {l.tipo === 'casa-central' ? <figcaption class="local__etiqueta">{l.ciudad}</figcaption> : <figcaption class="visualmente-oculto">{nombre}</figcaption>}
              {l.tipo === 'casa-central' && <span class="local__sello" aria-hidden="true"><Icono nombre="estrella" tamano={14} /> Sede principal</span>}
            </figure>
          )}
          <div class="local__cabecera">
            <Badge variant={varianteTipo[l.tipo]}>{TIPO_LOCAL[l.tipo]}</Badge>
            <h4 class="local__nombre">{l.tipo === 'casa-central' ? 'Casa Central' : l.ciudad}</h4>
            <span class="local__depto">{l.departamento}</span>
          </div>
          <ul class="local__datos">
            <li><Icono nombre="ubicacion" tamano={18} /><span>{l.direccion}, {l.ciudad}{l.accesoAlternativo && <small>{l.accesoAlternativo}</small>}</span></li>
            {l.telefono && (
              <li>
                <Icono nombre="telefono" tamano={18} />
                <span>
                  <a href={telHref(l.telefono)}>{l.telefono}</a>
                  {l.pendiente && <Badge variant="accent" class="local__pendiente">Teléfono pendiente de confirmación</Badge>}
                </span>
              </li>
            )}
            {l.celular && <li><Icono nombre="whatsapp" tamano={18} /><a href={telHref(l.celular)}>{l.celular}</a></li>}
            {l.email && <li><Icono nombre="correo" tamano={18} /><a href={`mailto:${l.email}`} class="local__email">{l.email.split('@')[0]}@<wbr />{l.email.split('@')[1]}</a></li>}
            {l.tipo === 'casa-central' && <li><Icono nombre="reloj" tamano={18} /><span>{HORARIOS.casaCentral.map((h) => `${h.dias}: ${h.horas}`).join(' · ')}</span></li>}
          </ul>
          <div class="local__acciones">
            <Button variant={l.tipo === 'casa-central' ? 'default' : 'secondary'} size="sm" data-ver-mapa={l.id}>
              <Icono nombre="mapa" tamano={17} /> Ver en el mapa<span class="visualmente-oculto">: {nombreLocal(l)}</span>
            </Button>
            <Button href={l.comoLlegar} variant="ghost" size="sm" target="_blank">
              <Icono nombre="ubicacion" tamano={17} /> Cómo llegar<span class="visualmente-oculto"> a {nombreLocal(l)}</span>
            </Button>
          </div>
        </li>
        );
      })}
    </ul>
    </section>
    ))}
    <div class="card card--dashed vacio" data-vacio hidden>
      <p>No hay locales con esos filtros. Probá con otro departamento o escribinos por WhatsApp.</p>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filtros-locales]')!;
  const items = [...document.querySelectorAll<HTMLElement>('[data-locales] > li')];
  const resultado = document.querySelector<HTMLElement>('[data-resultado]')!;
  const vacio = document.querySelector<HTMLElement>('[data-vacio]')!;
  const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];
  form.addEventListener('change', () => {
    const datos = new FormData(form);
    const tipo = String(datos.get('tipo') ?? '');
    const depto = String(datos.get('departamento') ?? '');
    let visibles = 0;
    items.forEach((li) => {
      const ok = (!tipo || li.dataset.tipo === tipo) && (!depto || li.dataset.departamento === depto);
      li.hidden = !ok;
      if (ok) visibles++;
    });
    grupos.forEach((g) => { g.hidden = !g.querySelector('[data-locales] > li:not([hidden])'); });
    resultado.textContent = `Mostrando ${visibles} ${visibles === 1 ? 'local' : 'locales'}.`;
    vacio.hidden = visibles > 0;
    document.dispatchEvent(new CustomEvent('copol:mapa-filtrar', { detail: { ids: items.filter((li) => !li.hidden).map((li) => li.dataset.punto) } }));
  });

  // Tocar una tarjeta (fuera de sus enlaces) o su botón "Ver en el mapa" lleva al mapa y acerca hasta el local.
  document.addEventListener('click', (e) => {
    const objetivo = e.target as HTMLElement;
    const boton = objetivo.closest<HTMLElement>('[data-ver-mapa]');
    const tarjeta = objetivo.closest<HTMLElement>('[data-punto]');
    if (!boton && (!tarjeta || objetivo.closest('a, button, select, input'))) return;
    if (!boton && getSelection()?.toString()) return; // estaba seleccionando texto (copiar una dirección)
    document.dispatchEvent(new CustomEvent('copol:mapa-enfocar', { detail: { id: boton?.dataset.verMapa ?? tarjeta!.dataset.punto } }));
  });
  document.addEventListener('copol:mapa-elegido', (e) => {
    const id = (e as CustomEvent<{ id: string }>).detail.id;
    items.forEach((li) => li.toggleAttribute('data-elegido', li.dataset.punto === id));
  });
</script>

<style>
  .filtros { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: flex-end; justify-content: space-between; }
  .filtros :global(.filtros__depto) { min-width: min(100%, 280px); }
  .resultado { margin: 20px 0 16px; color: var(--muted-foreground); font-weight: 600; }

  .grupo + .grupo { margin-top: clamp(32px, 5vw, 56px); }
  .grupo[hidden] { display: none; }
  .grupo__titulo { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; font-size: 1.375rem; }
  .grupo__cuenta {
    display: inline-grid; place-items: center; min-width: 28px; height: 28px; padding: 0 8px; border-radius: var(--radio-pill);
    background: var(--muted); color: var(--verde-oscuro); font-size: 0.875rem; font-weight: 700;
  }
  .locales {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
  /* Casa Central + 3 sucursales: 4 columnas iguales en escritorio, 2 en tablet, 1 en teléfono. */
  /* Casa Central + 3 sucursales: tarjetas grandes en 2 × 2 (escritorio y tablet), 1 columna en teléfono. */
  .locales--principales { grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 760px) { .locales--principales { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  .local__nombre { font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.01em; }
  .locales--principales .local { gap: 18px; }
  .locales--principales .local__nombre { font-size: 1.5rem; }
  .locales--principales .local__datos { font-size: 1rem; }
  @media (min-width: 1100px) {
    .locales--principales .local { padding: 12px 12px 22px; }
    .locales--principales .local > :not(.local__foto) { margin-inline: 12px; }
  }
  .local { gap: 16px; }
  .local__foto { position: relative; margin: -8px -8px 0; }
  .local__etiqueta {
    position: absolute; left: 10px; bottom: 10px; padding: 4px 12px; border-radius: var(--radio-pill);
    background: rgb(255 255 255 / 0.94); color: var(--verde-oscuro); font-weight: 700; font-size: 0.8125rem;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }
  /* Casa Central resaltada: borde verde más grueso, sombra, sello amarillo y título mayor. */
  .local--casa-central { box-shadow: inset 0 0 0 2.5px var(--verde-oscuro), 0 18px 40px -22px rgb(0 51 26 / 0.45); }
  .locales--principales .local--casa-central .local__nombre { font-size: 1.75rem; }
  .local__sello {
    position: absolute; left: 10px; top: 10px; display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: var(--radio-pill); background: var(--amarillo-copol); color: var(--verde-profundo);
    font-weight: 800; font-size: 0.8125rem; box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
  }
  .local__cabecera { display: grid; gap: 6px; justify-items: start; }
  .local__depto { font-size: 0.875rem; color: var(--muted-foreground); }
  .local__datos { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 0.9375rem; }
  .local__datos li { display: flex; gap: 10px; align-items: flex-start; }
  .local__datos :global(svg) { color: var(--verde-copol); flex: none; margin-top: 2px; }
  .local__datos small { display: block; color: var(--muted-foreground); }
  .local__datos :global(.local__pendiente) { display: flex; margin-top: 6px; white-space: normal; }
  .local__email { overflow-wrap: anywhere; }
  .local { cursor: pointer; transition: box-shadow 200ms var(--ease-out-quart); }
  .local[data-elegido] { box-shadow: inset 0 0 0 2.5px var(--verde-copol), 0 18px 40px -22px rgb(0 51 26 / 0.45); }
  .local--casa-central[data-elegido] { box-shadow: inset 0 0 0 3.5px var(--verde-copol), 0 18px 40px -22px rgb(0 51 26 / 0.45); }
  .local__acciones { margin-top: auto; display: flex; flex-wrap: wrap; gap: 8px; }
  .mapa-locales { padding-top: clamp(28px, 4vw, 48px); }
  .mapa-locales__ayuda { margin-top: 10px; font-size: 0.875rem; color: var(--muted-foreground); }
  .seccion--tras-mapa { padding-top: clamp(32px, 5vw, 56px); }
  .vacio { margin-top: 16px; text-align: center; align-items: center; }
</style>
