---
// Inicio con ritmo de tienda online: accesos rápidos y créditos arriba; luego bloques "banner + contenido"
// de cada sección (Bazar, Servicios sociales, Pinecoop), novedades y cierre con Hacete socio.
// Los banners son piezas entregadas por la cooperativa (docs/registro-de-activos.md § Banners de Inicio).
import Base from '../layouts/Base.astro';
import BannerInicio from '../components/BannerInicio.astro';
import '../styles/banner-inicio.css';
import AperturasCredito from '../components/AperturasCredito.astro';
import EstanteBazar from '../components/EstanteBazar.astro';
import BannerSeccion from '../components/BannerSeccion.astro';
import Icono from '../components/Icono.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import Media from '../components/ui/Media.astro';
import { CONVENIOS, LOCALES } from '../lib/datos';
import { foto } from '../lib/imagenes';
import { SERVICIOS } from '../data/confirmado/servicios';
import { BENEFICIOS_SOCIO } from '../data/confirmado/beneficios-socio';
import { CONTACTO, HORARIOS, whatsapp } from '../data/confirmado/sitio';
import bannerBazar from '../assets/banners/bazar.webp';
import bannerServicios from '../assets/banners/servicios-sociales.webp';
import bannerPinecoop from '../assets/banners/pinecoop.webp';
import bannerSocio from '../assets/banners/hacete-socio.webp';
// Banner "Consultá acá por tus beneficios" (entregado el 14/10/2026): lleva al WhatsApp general.
import bannerBeneficios from '../assets/banners/beneficios.webp';
// Versiones para celular (5:4), entregadas por la cooperativa: se usan por debajo de 640 px.
import bannerBazarMovil from '../assets/banners/bazar-movil.webp';
import bannerServiciosMovil from '../assets/banners/servicios-sociales-movil.webp';
import bannerPinecoopMovil from '../assets/banners/pinecoop-movil.webp';
import bannerSocioMovil from '../assets/banners/hacete-socio-movil.webp';

const pinecoop = SERVICIOS.find((s) => s.slug === 'pinecoop')!;
const otrosServicios = SERVICIOS.filter((s) => s.slug !== 'pinecoop');
const beneficios = BENEFICIOS_SOCIO.map((b) => (b.icono === 'ubicacion' ? { ...b, titulo: `${LOCALES.length} locales` } : b));

// Cada acceso dice algo concreto y verificable (horario, cantidades), no solo el nombre de la sección.
const horarioTienda = HORARIOS.casaCentral[0];
const accesos = [
  { texto: 'Acceso web', detalle: 'Saldo, crédito y estado de cuenta', href: '/acceso-web/', icono: 'candado', cifra: null, junto: null },
  { texto: 'Bazar', detalle: 'Hasta 15 cuotas sin recargo', href: '/hipermercado/bazar/', icono: 'celular', cifra: '15', junto: 'cuotas sin recargo, como máximo' },
  { texto: 'Tienda', detalle: `${horarioTienda.dias}, ${horarioTienda.horas}`, href: '/hipermercado/tienda/', icono: 'tienda', cifra: horarioTienda.horas.replace(':00', '').replace(':00', '').replace(' a ', '–'), junto: `${horarioTienda.dias}, en Casa Central` },
  { texto: 'Servicios sociales', detalle: `${SERVICIOS.length} servicios: salud, turismo y más`, href: '/beneficios/servicios-sociales/', icono: 'corazon', cifra: String(SERVICIOS.length), junto: 'salud, turismo, Pinecoop y más' },
  { texto: 'Convenios', detalle: `${CONVENIOS.length} comercios adheridos`, href: '/beneficios/convenios/', icono: 'convenio', cifra: String(CONVENIOS.length), junto: 'comercios en todo el país' },
  { texto: 'Locales', detalle: `${LOCALES.length} en todo el país`, href: '/sobre-nosotros/locales/', icono: 'ubicacion', cifra: String(LOCALES.length), junto: 'Casa Central, sucursales y agencias' },
] as const;

---
<Base titulo="Inicio" anchoCompleto>
  <!-- Título de la página siempre presente (el banner puede no tener diapositivas publicadas). -->
  <h1 class="visualmente-oculto">COPOL · Cooperativa Policial</h1>
  <!-- ── Banner: diapositivas editables desde el panel (Administración Página) ── -->
  <BannerInicio server:defer>
    <div slot="fallback" class="contenedor banner-inicio" aria-hidden="true"><div class="banner-esqueleto"></div></div>
  </BannerInicio>

  <div class="contenedor banner-beneficios">
    <BannerSeccion
      src={bannerBeneficios}
      href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola! Quiero consultar por mis beneficios de COPOL')}
      externo
      fondo="#3dae38"
      alt="Consultá acá por tus beneficios por WhatsApp. 2 parques vacacionales, más de 20 locales en todo el país y comprás en cuotas aún estando en clearing. Salud mental, estudio jurídico, Viajá con COPOL, clínica veterinaria y COPOL Salud Bucal."
    />
  </div>

  <section class="contenedor accesos" aria-labelledby="accesos-titulo">
    <h2 id="accesos-titulo" class="accesos__titulo"><span class="mascara"><span>¿Qué necesitás hoy?</span></span></h2>
    <ul class="indice escalonar">
      {accesos.map((a) => (
        <li>
          <a href={a.href} class="indice__item">
            <span class="indice__icono"><Icono nombre={a.icono} tamano={22} /></span>
            {a.cifra && <span class="indice__cifra" aria-hidden="true">{a.cifra}</span>}
            <strong class="indice__texto">{a.texto}</strong>
            <span class:list={['indice__detalle', { 'indice__detalle--sin-cifra': a.junto }]}>{a.detalle}</span>
            {a.junto && <span class="indice__detalle indice__detalle--con-cifra">{a.junto}</span>}
            <Icono nombre="flecha" tamano={18} clase="indice__flecha" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Fechas de crédito: se cargan en el panel; las pasadas se ocultan solas -->
  <AperturasCredito server:defer>
    <div slot="fallback" class="contenedor creditos-esqueleto" aria-hidden="true"><div></div></div>
  </AperturasCredito>

  <!-- ── Servicios sociales: banner + servicios ── -->
  <section class="contenedor bloque" aria-labelledby="servicios-titulo">
      <BannerSeccion src={bannerServicios} movil={bannerServiciosMovil} href="/beneficios/servicios-sociales/" alt="COPOL Servicios sociales. Ver todos los servicios sociales." />
      <h2 id="servicios-titulo" class="visualmente-oculto">Servicios sociales para vos y tu familia</h2>
      <ul class="servicios-lista escalonar">
        {otrosServicios.map((s) => (
          <li>
            <Card href={`/beneficios/servicios-sociales/${s.slug}/`} class="servicio-mini">
              <span class="card__icono"><Icono nombre={s.icono} tamano={22} /></span>
              <span class="servicio-mini__texto"><strong>{s.titulo}</strong><span>{s.resumen}</span></span>
              <Icono nombre="chevron-der" tamano={18} clase="servicio-mini__flecha" />
            </Card>
          </li>
        ))}
      </ul>
  </section>

  <!-- ── Bazar: banner + estante de productos ── -->
  <section class="contenedor bloque" aria-labelledby="bazar-titulo">
    <BannerSeccion src={bannerBazar} movil={bannerBazarMovil} href="/hipermercado/bazar/" alt="Bazar: todo para ti y tu hogar. Hasta 15 cuotas sin recargo. Ver el catálogo del Bazar." />
    <h2 id="bazar-titulo" class="visualmente-oculto">Lo más buscado del Bazar</h2>
    <!-- Stock vigente: se genera en cada visita a partir de la base del panel -->
    <EstanteBazar server:defer cantidad={10}>
      <div slot="fallback" class="estante-esqueleto" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    </EstanteBazar>
  </section>

  <!-- ── Pinecoop: banner + detalle ── -->
  <section class="contenedor bloque" aria-labelledby="pinecoop-titulo">
    <BannerSeccion src={bannerPinecoop} movil={bannerPinecoopMovil} href="/beneficios/servicios-sociales/pinecoop/" alt="Pinecoop: piscina, reposeras y sombrillas del Parque Vacacional. Ver más sobre Pinecoop." />
    <div class="pinecoop">
      <div class="pinecoop__texto">
        <h2 id="pinecoop-titulo"><span class="mascara"><span>{pinecoop.titulo}</span></span></h2>
        <p class="lead">{pinecoop.descripcion}</p>
        <div class="pinecoop__acciones">
          <Button href="/beneficios/servicios-sociales/pinecoop/" size="lg">Conocé Pinecoop <Icono nombre="flecha" tamano={18} /></Button>
          <Button href={pinecoop.cta.href} variant="outline" size="lg"><Icono nombre="whatsapp" tamano={18} /> Consultá disponibilidad</Button>
        </div>
      </div>
      <ul class="lista-check pinecoop__lista escalonar">
        {pinecoop.puntos.map((p) => <li><Icono nombre="check" tamano={18} />{p}</li>)}
      </ul>
      <a href="/beneficios/servicios-sociales/pinecoop/" class="pinecoop__chuy grupo-hover">
        <Media src={foto('pinecoop-chuy')} alt="Pinecoop Chuy" widths={[320, 480, 640]} sizes="(min-width: 900px) 300px, 100vw" />
        <span><Badge variant="accent">Próximamente</Badge> <strong>Pinecoop Chuy</strong></span>
      </a>
    </div>
  </section>

  <!-- ── Hacete socio: banner + beneficios ── -->
  <section class="contenedor bloque bloque--final" aria-labelledby="socio-titulo">
      <BannerSeccion src={bannerSocio} movil={bannerSocioMovil} href="/hacete-socio/" alt="Hacete socio de COPOL. Ver cómo hacerte socio." />
      <h2 id="socio-titulo" class="visualmente-oculto">Hacete socio: sumate a COPOL</h2>
      <ul class="beneficios escalonar">
        {beneficios.map((b) => (
          <li>
            <a href={b.href} class="beneficio">
              <Icono nombre={b.icono} tamano={22} clase="beneficio__icono" />
              <strong>{b.titulo}</strong>
              <span>{b.texto}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="socio__acciones">
        <Button href="/hacete-socio/">Cómo hacerte socio <Icono nombre="flecha" tamano={18} /></Button>
        <Button href={whatsapp(CONTACTO.whatsappSocios.numero, 'Hola, quiero info para asociarme')} variant="outline"><Icono nombre="whatsapp" tamano={18} /> {CONTACTO.whatsappSocios.texto}</Button>
      </div>
  </section>
</Base>

<script>
  // <copol-banner> se activa solo cuando llega el HTML del banner (server island).
  import '../scripts/banner-inicio.js';
</script>

<style>
  /* Banner de Inicio: el espacio queda reservado mientras llega (sin saltos de diseño). */
  .banner-inicio { padding-top: clamp(16px, 2.4vw, 28px); }
  .banner-esqueleto { border-radius: var(--radio-xl); background: var(--muted); aspect-ratio: 8 / 3; margin-bottom: 52px; }
  @media (max-width: 783px) { .banner-esqueleto { aspect-ratio: auto; height: min(118vw, 560px); border-radius: var(--radio-md); } }
  @media (min-width: 784px) { .banner-esqueleto { border-radius: 0; max-height: 680px; } }

  /* Banner de beneficios entre el banner de Inicio y los accesos rápidos */
  .banner-beneficios { padding-top: clamp(16px, 2.4vw, 32px); }
  .accesos { padding-top: var(--seccion); }
  .accesos__titulo { font-size: clamp(1.625rem, 2.8vw, 2.25rem); margin-bottom: clamp(16px, 2vw, 24px); }

  /* Índice de accesos: seis entradas con un dato real cada una. 6 → 3 → 2 columnas, nunca una huérfana. */
  .indice {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 720px) { .indice { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1180px) { .indice { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .indice > li { display: flex; }
  .indice__item {
    position: relative; flex: 1;
    display: grid; align-content: start; gap: 4px;
    padding: 18px 18px 20px;
    border-radius: var(--radio-lg); border: var(--card-borde); background: var(--blanco);
    color: var(--foreground); text-decoration: none;
    transition: background-color 180ms var(--ease-out-quart), color 180ms var(--ease-out-quart), box-shadow 250ms var(--ease-out-quart), border-color 180ms var(--ease-out-quart);
  }
  .indice__item:hover { color: var(--foreground); border-color: var(--borde-fuerte); box-shadow: var(--sombra-suave); }
  .indice__icono {
    display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 10px;
    border-radius: var(--radio-md); background: var(--muted); color: var(--verde-oscuro);
  }
  .indice__texto { font-size: 1.0625rem; line-height: 1.2; color: var(--verde-oscuro); }
  .indice__detalle { font-size: 0.9375rem; line-height: 1.4; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  .indice :global(.indice__flecha) {
    position: absolute; top: 20px; right: 18px; color: var(--verde-oscuro);
    opacity: 0; transform: translateX(-6px); transition: opacity var(--transicion), transform 400ms var(--resorte);
  }
  .indice__item:hover :global(.indice__flecha),
  .indice__item:focus-visible :global(.indice__flecha) { opacity: 1; transform: none; }
  @media (max-width: 479px) {
    .indice { gap: 10px; }
    .indice__item { padding: 14px 14px 16px; }
    .indice__detalle { font-size: 0.875rem; }
  }

  /* Afiche: el índice es una fila impresa entre filetes; cada entrada se separa con una línea de tinta y
     al pasar el puntero se entinta de verde. */
  :global(:root[data-estilo='afiche']) .accesos__titulo { padding-top: 14px; border-top: var(--filete-fuerte); }
  :global(:root[data-estilo='afiche']) .indice { gap: 0; border-bottom: var(--filete); }
  :global(:root[data-estilo='afiche']) .indice > li { border-top: var(--filete); }
  :global(:root[data-estilo='afiche']) .indice__item { background: transparent; border: 0; border-radius: 0; padding: 18px 18px 22px; }
  :global(:root[data-estilo='afiche']) .indice > li + li .indice__item { box-shadow: inset 2px 0 0 var(--tinta); }
  @media (max-width: 719px) {
    :global(:root[data-estilo='afiche']) .indice > li + li:nth-child(odd) .indice__item { box-shadow: none; }
  }
  @media (min-width: 720px) and (max-width: 1179px) {
    :global(:root[data-estilo='afiche']) .indice > li + li:nth-child(3n + 1) .indice__item { box-shadow: none; }
  }
  :global(:root[data-estilo='afiche']) .indice__icono { width: auto; height: auto; justify-content: start; background: none; margin-bottom: 14px; }
  .indice__cifra, .indice__detalle--con-cifra { display: none; }
  /* Afiche: debajo de la cifra va un dato que la complementa en lugar de repetirla. */
  :global(:root[data-estilo='afiche']) .indice__detalle--sin-cifra { display: none; }
  :global(:root[data-estilo='afiche']) .indice__detalle--con-cifra { display: block; }
  /* Afiche: la cifra real es la protagonista (numeral condensado y tabular); el ícono queda solo donde no hay cifra. */
  :global(:root[data-estilo='afiche']) .indice__item:has(.indice__cifra) .indice__icono { display: none; }
  :global(:root[data-estilo='afiche']) .indice__cifra {
    display: block; margin-bottom: 8px; font-family: var(--fuente-titulo); font-stretch: 66%; font-weight: 800;
    font-size: clamp(2.75rem, 4.6vw, 4rem); line-height: 0.86; letter-spacing: -0.01em; color: var(--verde-oscuro); font-variant-numeric: tabular-nums;
  }
  :global(:root[data-estilo='afiche']) .indice__item:hover .indice__cifra { color: var(--blanco-verdozo); }
  :global(:root[data-estilo='afiche']) .indice__icono { min-height: calc(clamp(2.75rem, 4.6vw, 4rem) * 0.86); align-items: end; }
  :global(:root[data-estilo='afiche']) .indice__texto {
    font-family: var(--fuente-titulo); font-stretch: 72%; font-weight: 800; text-transform: uppercase;
    font-size: clamp(1.375rem, 2vw, 1.75rem); line-height: 0.95;
  }
  :global(:root[data-estilo='afiche']) .indice__item:hover { background: var(--verde-oscuro); box-shadow: none; }
  :global(:root[data-estilo='afiche']) .indice__item:hover .indice__texto,
  :global(:root[data-estilo='afiche']) .indice__item:hover .indice__icono,
  :global(:root[data-estilo='afiche']) .indice__item:hover :global(.indice__flecha) { color: var(--blanco-verdozo); }
  :global(:root[data-estilo='afiche']) .indice__item:hover .indice__detalle { color: var(--sobre-verde); }

  /* Folleto: etiquetas de góndola con borde verde grueso; el ícono va en un círculo amarillo. */
  :global(:root[data-estilo='folleto']) .indice__icono { border-radius: 50%; background: var(--amarillo-copol); }
  :global(:root[data-estilo='folleto']) .indice__texto { font-family: var(--fuente-titulo); font-stretch: 108%; font-weight: 900; font-size: 1.125rem; }
  :global(:root[data-estilo='folleto']) .indice__item:hover { background: var(--amarillo-copol); box-shadow: none; border-color: var(--verde-oscuro); }
  :global(:root[data-estilo='folleto']) .indice__item:hover .indice__icono { background: var(--blanco); }

  /* Todos los bloques: misma separación entre secciones y entre el banner y su contenido */
  .bloque :global(.estante-bazar) { gap: 16px; }

  /* Íconos quietos: sin gestos animados ni giros al pasar el puntero (solo Inicio) */
  main :global(.icono__g), main :global(.icono__parte) { animation: none !important; }
  main :global(a.card:hover .card__icono) { transform: none; }

  /* Bloque de sección: banner → cabecera con llamado a la acción → contenido */

  /* Servicios */
  .servicios-lista {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 14px;
    /* 6 servicios: 3 × 2 en computadora, 2 × 3 en tableta y 1 columna en celular (sin tarjeta huérfana) */
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .servicios-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .servicios-lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .servicios-lista > li { display: flex; }
  .servicios-lista :global(.servicio-mini) { flex: 1; flex-direction: row; align-items: center; gap: 14px; padding: 16px 18px; }
  .servicio-mini__texto { display: grid; flex: 1; }
  .servicio-mini__texto strong { color: var(--verde-oscuro); }
  .servicio-mini__texto span { font-size: 0.875rem; color: var(--muted-foreground); }
  .servicios-lista :global(.servicio-mini__flecha) { color: var(--verde-oscuro); flex: none; transition: transform 300ms var(--resorte); }
  .servicios-lista :global(.servicio-mini:hover .servicio-mini__flecha) { transform: translateX(3px); }

  /* Pinecoop */
  .pinecoop { display: grid; gap: clamp(20px, 3vw, 40px); align-items: start; }
  @media (min-width: 1000px) { .pinecoop { grid-template-columns: 1.2fr 1fr 300px; } }
  @media (min-width: 700px) and (max-width: 999px) { .pinecoop { grid-template-columns: 1fr 1fr; } .pinecoop__texto { grid-column: 1 / -1; } }
  .pinecoop__texto { display: grid; gap: 14px; justify-items: start; }
  .pinecoop__acciones { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 599px) {
    .pinecoop__texto { justify-items: stretch; }
    .pinecoop__acciones :global(.btn) { flex: 1 1 100%; }
  }
  .lista-check { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lista-check li { display: flex; gap: 10px; align-items: flex-start; }
  .lista-check :global(svg) { color: var(--verde-copol); margin-top: 3px; flex: none; }
  .pinecoop__lista { padding: 20px; border-radius: var(--radio-lg); background: var(--card); box-shadow: var(--anillo); }
  .pinecoop__chuy { display: grid; gap: 10px; text-decoration: none; color: var(--foreground); }
  .pinecoop__chuy span { display: flex; align-items: center; gap: 8px; }

  /* Hacete socio: el banner es el título; los botones van debajo de los beneficios */
  .socio__acciones { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 8px; }

  /* Beneficios de socio */
  /* Beneficios de socio: lista entre filetes (no tarjetas iguales), 2 columnas en celular y 4 en computadora. */
  .beneficios { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 clamp(16px, 2.4vw, 32px); grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: var(--filete); }
  @media (min-width: 900px) { .beneficios { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .beneficios > li { display: flex; border-top: var(--filete); }
  .beneficio { flex: 1; display: grid; align-content: start; gap: 4px; padding: 16px 0 20px; color: var(--foreground); text-decoration: none; }
  .beneficio:hover { color: var(--foreground); }
  .beneficio:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .beneficios :global(.beneficio__icono) { color: var(--verde-copol); margin-bottom: 6px; }
  .beneficio strong { font-size: 1.0625rem; color: var(--verde-oscuro); }
  .beneficio span { color: var(--muted-foreground); font-size: 0.9375rem; }
  :global(:root[data-estilo='afiche']) .beneficio strong { font-family: var(--fuente-titulo); font-stretch: 72%; font-weight: 800; text-transform: uppercase; font-size: 1.5rem; line-height: 0.95; }
</style>
