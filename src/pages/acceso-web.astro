---
import Base from '../layouts/Base.astro';
import EncabezadoPagina from '../components/EncabezadoPagina.astro';
import AperturasCredito from '../components/AperturasCredito.astro';
import Icono from '../components/Icono.astro';
import { ACCESO, CONTACTO, whatsapp } from '../data/confirmado/sitio';
import Button from '../components/ui/Button.astro';
---
<Base titulo="Acceso web" descripcion="Acceso web de COPOL: ingresá a tu cuenta de socio, el portal de empleados (recibos, reglamento y protocolos) y la app para Android.">
  <EncabezadoPagina
    titulo="Acceso web"
    antetitulo="Autogestión"
    bajada="Accedé de forma segura a tu cuenta de socio o al portal de empleados de COPOL."
    migas={[{ texto: 'Acceso web' }]}
  />

  <section class="contenedor seccion" aria-labelledby="accesos-titulo">
    <h2 id="accesos-titulo"><span class="mascara"><span>Elegí tu acceso</span></span></h2>
    <ul class="accesos escalonar">
      <!-- 1. Socio: el acceso principal, con color de marca y degradé -->
      <li>
        <a href={ACCESO.socios} class="acceso acceso--socios" rel="noopener">
          <span class="acceso__aro" aria-hidden="true"></span>
          <div class="acceso__principal">
            <span class="acceso__badge">Para socios</span>
            <span class="acceso__icono"><Icono nombre="usuario" tamano={40} /></span>
            <h3>Mi cuenta de socio</h3>
            <span class="acceso__cta">Ingresar <Icono nombre="externo" tamano={20} /><span class="visualmente-oculto"> (portal externo de COPOL)</span></span>
          </div>
          <ul class="acceso__lista">
            <li><Icono nombre="check" tamano={20} />Saldo disponible de tu crédito</li>
            <li><Icono nombre="check" tamano={20} />Estados de cuenta en PDF</li>
            <li><Icono nombre="check" tamano={20} />Cambio de clave y datos</li>
          </ul>
        </a>
      </li>
      <!-- 2. Portal de empleados, debajo y con menos protagonismo que el de socio -->
      <li>
        <a href="/portal-empleados/" class="acceso acceso--empleados">
          <div class="acceso__principal">
            <span class="acceso__badge acceso__badge--claro">Para funcionarios</span>
            <span class="acceso__icono"><Icono nombre="usuarios" tamano={34} /></span>
            <h3>Portal de empleados</h3>
            <span class="acceso__cta">Entrar <Icono nombre="flecha" tamano={20} /></span>
          </div>
          <ul class="acceso__lista">
            <li><Icono nombre="check" tamano={20} />Tus recibos de sueldo</li>
            <li><Icono nombre="check" tamano={20} />Reglamento interno y protocolo de acoso laboral</li>
            <li><Icono nombre="check" tamano={20} />Novedades de la cooperativa y nuevas sedes</li>
          </ul>
        </a>
      </li>
      {ACCESO.appAndroid && (
        <li>
          <a href={ACCESO.appAndroid} class="acceso acceso--app" rel="noopener">
            <div class="acceso__principal">
              <span class="acceso__badge acceso__badge--claro">App</span>
              <span class="acceso__icono"><Icono nombre="celular" tamano={30} /></span>
              <h3>App COPOL para Android</h3>
              <span class="acceso__cta">Descargar <Icono nombre="descarga" tamano={20} /></span>
            </div>
            <p>Consultá tu crédito y descargá estados de cuenta desde el celular.</p>
          </a>
        </li>
      )}
    </ul>
  </section>

  <section class="contenedor" aria-labelledby="ayuda-titulo">
    <div class="card ayuda">
      <span class="card__icono"><Icono nombre="info" tamano={26} /></span>
      <div>
        <h2 id="ayuda-titulo">¿No podés ingresar?</h2>
        <p>Si olvidaste tu clave o es la primera vez que usás el portal, escribinos por WhatsApp y te ayudamos. También podés acercarte a cualquier local de COPOL.</p>
      </div>
      <div class="ayuda__acciones">
        <Button href={whatsapp(CONTACTO.whatsappGeneral.numero, 'Hola, necesito ayuda para ingresar a Acceso web')}><Icono nombre="whatsapp" tamano={18} /> Pedir ayuda</Button>
        <Button href="/sobre-nosotros/locales/" variant="outline">Ver locales</Button>
      </div>
    </div>
  </section>

  <!-- Fechas de crédito: se cargan en el panel; las pasadas se ocultan solas -->
  <AperturasCredito server:defer>
    <div slot="fallback" class="contenedor creditos-esqueleto" aria-hidden="true"><div></div></div>
  </AperturasCredito>
</Base>

<style>
  .accesos { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: clamp(16px, 2vw, 24px); }
  .acceso {
    position: relative; display: grid; gap: 22px 40px; align-items: center; overflow: hidden; isolation: isolate;
    padding: clamp(26px, 4vw, 52px); border-radius: var(--radio-xl); text-decoration: none;
    transition: box-shadow 300ms var(--ease-out-quart), transform 450ms var(--resorte), background-position 700ms var(--ease-out-quart);
  }
  @media (min-width: 860px) { .acceso { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (prefers-reduced-motion: no-preference) { a.acceso:hover { transform: translateY(-5px); } }
  .acceso__principal { display: grid; gap: 14px; justify-items: start; }
  .acceso h3 { font-size: clamp(1.75rem, 3.6vw, 2.75rem); line-height: 1.05; }
  .acceso__badge { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tinta); background: var(--amarillo-copol); padding: 5px 12px; border-radius: var(--radio-pill); }
  .acceso__badge--claro { background: var(--muted); color: var(--verde-oscuro); }
  .acceso__icono { display: inline-flex; align-items: center; justify-content: center; transition: transform 500ms var(--resorte); }
  a.acceso:hover .acceso__icono { transform: rotate(-6deg) scale(1.06); }
  .acceso__lista { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; font-size: 1.125rem; }
  .acceso__lista li { display: flex; gap: 12px; align-items: flex-start; }
  .acceso__lista :global(svg) { flex: none; margin-top: 3px; }
  .acceso__cta { display: inline-flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.125rem; padding: 12px 22px; border-radius: var(--radio-pill); transition: gap 300ms var(--resorte); }
  a.acceso:hover .acceso__cta { gap: 16px; }

  /* Socio: degradé de marca, aro decorativo y llamado amarillo */
  .acceso--socios {
    min-height: clamp(300px, 34vw, 400px); color: var(--sobre-verde);
    background-image: linear-gradient(130deg, #0b3d22 0%, var(--verde-oscuro) 40%, var(--verde-copol) 100%); background-size: 140% 140%; background-position: 0% 50%;
    box-shadow: var(--sombra);
  }
  a.acceso--socios:hover { background-position: 100% 50%; box-shadow: inset 0 0 0 3px var(--amarillo-copol), var(--sombra); color: var(--sobre-verde); }
  .acceso--socios h3 { color: var(--blanco); }
  .acceso--socios .acceso__icono { width: 80px; height: 80px; border-radius: var(--radio-md); background: var(--amarillo-copol); color: var(--tinta); }
  .acceso--socios .acceso__cta { background: var(--amarillo-copol); color: var(--tinta); font-size: 1.25rem; padding: 14px 28px; }
  .acceso--socios .acceso__lista { font-size: 1.1875rem; }
  .acceso--socios .acceso__lista :global(svg) { color: var(--amarillo-copol); }
  .acceso__aro { position: absolute; z-index: -1; right: -90px; top: -90px; width: 360px; height: 360px; border-radius: 50%; border: 56px solid rgb(255 255 255 / 0.07); pointer-events: none; }
  .acceso__aro::after { content: ''; position: absolute; inset: 70px; border-radius: 50%; background: rgb(255 255 255 / 0.05); }

  /* Empleados: grande, pero con un tratamiento más sobrio que el de socio */
  .acceso--empleados { min-height: clamp(220px, 24vw, 280px); background: var(--blanco); color: var(--foreground); border: var(--card-borde); box-shadow: inset 0 0 0 2px var(--verde-copol), var(--sombra-suave); }
  a.acceso--empleados:hover { box-shadow: inset 0 0 0 2px var(--verde-oscuro), var(--sombra); color: var(--foreground); }
  .acceso--empleados h3 { color: var(--verde-oscuro); }
  .acceso--empleados .acceso__icono { width: 68px; height: 68px; border-radius: var(--radio-md); background: var(--muted); color: var(--verde-oscuro); }
  .acceso--empleados .acceso__cta { background: var(--verde-oscuro); color: var(--blanco); }
  .acceso--empleados .acceso__lista :global(svg) { color: var(--verde-copol); }

  .acceso--app { background: var(--card); box-shadow: var(--anillo); color: var(--foreground); }
  .acceso--app h3 { font-size: 1.5rem; color: var(--verde-oscuro); }
  .acceso--app .acceso__cta { background: var(--muted); color: var(--verde-oscuro); }

  .ayuda { flex-direction: row; flex-wrap: wrap; gap: 20px; align-items: center; padding: clamp(22px, 3vw, 32px); border-radius: var(--radio-xl); margin-top: clamp(32px, 4vw, 48px); }
  .ayuda > div:nth-child(2) { flex: 1 1 360px; display: grid; gap: 6px; }
  .ayuda h2 { font-size: 1.5rem; }
  .ayuda__acciones { display: flex; flex-wrap: wrap; gap: 10px; }
</style>
