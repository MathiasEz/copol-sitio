# Copiar como .env para desarrollo local. En Vercel, cargar estos valores en
# Project Settings → Environment Variables. Este archivo NO debe contener valores reales.

# ── Base de datos (stock, productos, novedades, usuarios) ───────────────────────────────
# Producción: Turso (libSQL). Si se conecta desde el Marketplace de Vercel, estas dos
# variables se crean solas. Sin ellas, en desarrollo se usa el archivo panel/datos/copol.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Imágenes subidas desde el panel (productos y novedades) ─────────────────────────────
# Vercel Blob: se crea sola al conectar un Blob Store al proyecto. Sin ella, en desarrollo
# las imágenes se guardan en panel/datos/imagenes/. En producción es obligatoria.
BLOB_READ_WRITE_TOKEN=
# Respaldo diario cifrado (Cron de Vercel, src/pages/api/cron/respaldo.ts): secreto del Cron y clave de
# cifrado (24+ caracteres al azar). Guardar la clave también fuera de Vercel: sin ella no se puede restaurar.
CRON_SECRET=
RESPALDO_CLAVE=

# ── Formulario de contacto ──────────────────────────────────────────────────────────────
# Endpoint que recibe el formulario (POST multipart/form-data). Sin valor: modo demostración.
PUBLIC_FORM_ENDPOINT=

# ── Copia de prueba ─────────────────────────────────────────────────────────────────────
# 1 = agrega <meta name="robots" content="noindex"> en todas las páginas (para la URL
# *.vercel.app mientras el sitio esté en prueba). Quitarla al publicar en el dominio final.
# Las vistas previas de Vercel (VERCEL_ENV=preview) ya lo hacen solas.
# SITIO_DE_PRUEBA=1

# ── Asistente del panel (Claude vía Vercel AI Gateway) ──────────────────────────────────
# En Vercel no hace falta ninguna clave: usa el token OIDC del despliegue. Requiere AI Gateway
# habilitado en la cuenta (Vercel → AI Gateway). Solo fuera de Vercel se usaría una clave propia.
# AI_GATEWAY_API_KEY=
# PANEL_ASISTENTE_LIMITE_DIA=80

# ── Acceso al panel: código de verificación por correo (Resend) ─────────────────────────
# Clave de la API de Resend (resend.com → API Keys, permiso "Sending access"). Sin ella, el paso del
# código por correo queda en pausa y el panel lo avisa a los administradores.
# RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend solo se puede usar onboarding@resend.dev y enviar
# al correo de la cuenta de Resend. Con cooperativapolicial.com.uy verificado: Panel COPOL <panel@...>.
# PANEL_CORREO_REMITENTE=Panel COPOL <onboarding@resend.dev>
# Conector para Claude (MCP + OAuth). Apagado: sus metadatos públicos revelarían la dirección del panel.
# PANEL_CONECTOR_CLAUDE=1

# ── Opcionales del panel ────────────────────────────────────────────────────────────────
# PANEL_SESION_INACTIVIDAD_MIN=30
# PANEL_SESION_MAX_HORAS=8
# PANEL_MAX_IMAGEN_MB=5
# PANEL_RESPALDOS=datos/respaldos
# PANEL_RESPALDOS_CONSERVAR=30
